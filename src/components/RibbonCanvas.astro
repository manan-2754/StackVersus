---

---

<canvas id="zajno-motion-canvas" aria-hidden="true"></canvas>

<style is:global>
  #zajno-motion-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #zajno-motion-canvas {
      display: none;
    }
  }
</style>

<script>
  const canvas = document.getElementById('zajno-motion-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  if (canvas && ctx) {
    let animationId: number;
    let isVisible = true;
    let lastFrameTime = 0;
    const targetFps = 30;
    const frameInterval = 1000 / targetFps;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    document.addEventListener('visibilitychange', () => {
      isVisible = document.visibilityState === 'visible';
      if (!isVisible && animationId) {
        cancelAnimationFrame(animationId);
      } else if (isVisible) {
        animationId = requestAnimationFrame(renderScene);
      }
    });

    // 3D perspective grid state
    let gridOffset = 0;
    const gridSpeed = 0.0008;

    // Floating particles
    type Particle = { x: number; y: number; z: number; vx: number; vy: number; radius: number };
    const particles: Particle[] = [];
    for (let i = 0; i < 36; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        z: Math.random() * 1.5 + 0.5,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        radius: Math.random() * 1.5 + 0.5,
      });
    }

    let time = 0;
    function renderScene(timestamp: number) {
      if (!isVisible) return;

      animationId = requestAnimationFrame(renderScene);
      const elapsed = timestamp - lastFrameTime;
      if (elapsed < frameInterval) return;
      lastFrameTime = timestamp - (elapsed % frameInterval);

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      time += 0.016;
      gridOffset += gridSpeed;
      if (gridOffset > 1) gridOffset -= 1;

      const centerX = canvas.width * 0.5;
      const horizonY = canvas.height * 0.32;
      const bottomY = canvas.height;
      const floorHeight = bottomY - horizonY;

      // Perspective grid floor
      const gridColor = 'rgba(106, 75, 205, 0.14)';
      ctx.strokeStyle = gridColor;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 1;

      // Vertical lines radiating from vanishing point
      const xOffsets = [-2, -1.4, -0.85, -0.4, 0, 0.4, 0.85, 1.4, 2];
      xOffsets.forEach((offset) => {
        const farX = centerX + offset * canvas.width * 0.35;
        ctx.beginPath();
        ctx.moveTo(centerX, horizonY);
        ctx.lineTo(farX, bottomY);
        ctx.stroke();
      });

      // Horizontal moving lines with perspective acceleration
      const hLines = 14;
      for (let i = 0; i < hLines; i++) {
        let z = (i / hLines + gridOffset) % 1;
        const y = horizonY + floorHeight * (z * z * (3 - 2 * z));
        const alpha = 0.06 + z * 0.2;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // Subtle horizon glow
      const horizonGlow = ctx.createLinearGradient(0, horizonY - 60, 0, horizonY + 80);
      horizonGlow.addColorStop(0, 'rgba(106, 75, 205, 0)');
      horizonGlow.addColorStop(0.5, 'rgba(106, 75, 205, 0.08)');
      horizonGlow.addColorStop(1, 'rgba(106, 75, 205, 0)');
      ctx.fillStyle = horizonGlow;
      ctx.fillRect(0, horizonY - 60, canvas.width, 140);

      // Floating neon ribbons (upper portion)
      const ribbons = [
        { color: '#6a4bcd', alpha: 0.22, width: 2.5, speed: 1.0, freq: 0.0018, amp: 70, yBias: 0.18 },
        { color: '#d66bb2', alpha: 0.18, width: 2.0, speed: 1.3, freq: 0.0022, amp: 95, yBias: 0.26 },
        { color: '#de8ad4', alpha: 0.12, width: 1.5, speed: 0.8, freq: 0.0015, amp: 55, yBias: 0.12 },
      ];

      ribbons.forEach((ribbon, i) => {
        ctx.beginPath();
        ctx.strokeStyle = ribbon.color;
        ctx.lineWidth = ribbon.width;
        ctx.globalAlpha = ribbon.alpha;
        const baseY = canvas.height * ribbon.yBias;

        for (let x = 0; x <= canvas.width; x += 10) {
          const normY = mouseY / canvas.height;
          const dynamicAmp = ribbon.amp * (0.7 + normY * 0.6);
          const y =
            baseY + Math.sin(x * ribbon.freq + time * ribbon.speed + i) * dynamicAmp * Math.cos(time * 0.35 + i);
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      });

      // Floating particles
      particles.forEach((p) => {
        p.x += p.vx * p.z;
        p.y += p.vy * p.z;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;

        const alpha = 0.12 * p.z;
        ctx.fillStyle = `rgba(5, 3, 12, ${alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius * p.z, 0, Math.PI * 2);
        ctx.fill();
      });

      // Mouse flare
      const flare = ctx.createRadialGradient(mouseX, mouseY, 10, mouseX, mouseY, 420);
      flare.addColorStop(0, 'rgba(106, 75, 205, 0.09)');
      flare.addColorStop(1, 'transparent');
      ctx.fillStyle = flare;
      ctx.globalAlpha = 1;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    renderScene(0);
  }
</script>
