---

---

<div class="aurora-bg" aria-hidden="true">
  <div class="aurora-blob blob-1"></div>
  <div class="aurora-blob blob-2"></div>
  <div class="aurora-blob blob-3"></div>
  <div class="aurora-grid"></div>
  <div class="aurora-noise"></div>
</div>

<style is:global>
  .aurora-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.45;
    animation: blob-drift 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  .blob-1 {
    width: 70vw;
    height: 70vw;
    background: radial-gradient(circle, rgba(106, 75, 205, 0.45), transparent 60%);
    top: -20vw;
    left: -20vw;
    animation-duration: 22s;
  }

  .blob-2 {
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(214, 107, 178, 0.4), transparent 60%);
    bottom: -20vw;
    right: -20vw;
    animation-duration: 26s;
    animation-delay: -6s;
  }

  .blob-3 {
    width: 45vw;
    height: 45vw;
    background: radial-gradient(circle, rgba(222, 138, 212, 0.35), transparent 60%);
    top: 30%;
    left: 40%;
    animation-duration: 20s;
    animation-delay: -12s;
  }

  @keyframes blob-drift {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(6vw, 4vh, 0) scale(1.08);
    }
  }

  .aurora-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(106, 75, 205, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(106, 75, 205, 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 0%, black 0%, transparent 70%);
  }

  .aurora-noise {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-blob {
      animation: none;
    }
  }
</style>
