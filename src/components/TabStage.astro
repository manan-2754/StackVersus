---
import Shape from './Shape.astro';

export interface Props {
  kind: 'overview' | 'specs' | 'faq' | 'community';
  toolA: string;
  toolB: string;
  category?: string;
}

const { kind, toolA, toolB, category = '' } = Astro.props;

const initials = (name: string) =>
  name
    .replace(/[^A-Za-z0-9 ]/g, ' ')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('') || name.slice(0, 2).toUpperCase();

type Theme = { shape: string; accent: 'purple' | 'pink' | 'lavender' | 'cyan' };

function getTheme(category: string): Theme {
  const cat = category.toLowerCase();
  // Most specific categories first so "AI Frameworks" becomes a neural node, not a layer.
  if (cat.includes('database') || cat.includes('storage')) return { shape: 'shard', accent: 'cyan' };
  if (cat.includes('ai') || cat.includes('machine learning') || cat.includes('llm') || cat.includes('model'))
    return { shape: 'node', accent: 'pink' };
  if (cat.includes('security') || cat.includes('auth')) return { shape: 'shield', accent: 'purple' };
  if (cat.includes('monitor') || cat.includes('observ')) return { shape: 'ring', accent: 'cyan' };
  if (cat.includes('design') || cat.includes('creative') || cat.includes('ui') || cat.includes('ux'))
    return { shape: 'sphere', accent: 'pink' };
  if (cat.includes('mobile') || cat.includes('native')) return { shape: 'hex', accent: 'lavender' };
  if (cat.includes('cloud') || cat.includes('hosting') || cat.includes('infrastructure') || cat.includes('platform'))
    return { shape: 'hex', accent: 'lavender' };
  if (cat.includes('framework') || cat.includes('frontend') || cat.includes('javascript'))
    return { shape: 'layer', accent: 'purple' };
  return { shape: 'cube', accent: 'purple' };
}

const themeA = getTheme(category);
const themeB = getTheme(category);
---

{
  kind === 'overview' && (
    <div class="tab-stage stage-duel" data-stage="overview" data-theme={themeA.shape} aria-hidden="true">
      <svg class="duel-svg">
        <defs>
          <linearGradient id="duel-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#6a4bcd" />
            <stop offset="50%" stop-color="#de8ad4" />
            <stop offset="100%" stop-color="#d66bb2" />
          </linearGradient>
        </defs>
        <path class="duel-beam-glow" />
        <path class="duel-beam" />
      </svg>
      <div class="shape shape-a" data-shape={themeA.shape} data-accent={themeA.accent}>
        <Shape shape={themeA.shape} initials={initials(toolA)} />
      </div>
      <div class="duel-spark" />
      <div class="shape shape-b" data-shape={themeB.shape} data-accent={themeB.accent}>
        <Shape shape={themeB.shape} initials={initials(toolB)} />
      </div>
      <p class="stage-hint">Move to shift the balance · click to fire a pulse</p>
    </div>
  )
}

{
  kind === 'specs' && (
    <div class="tab-stage stage-balance" data-stage="specs" data-theme={themeA.shape} aria-hidden="true">
      <div class="balance-rig">
        <div class="balance-pillar" />
        <div class="balance-beam">
          <div class="balance-pan pan-a">
            <span class="pan-strings" />
            <div class="pan-dish">
              <div class="shape shape-a" data-shape={themeA.shape} data-accent={themeA.accent}>
                <Shape shape={themeA.shape} initials={initials(toolA)} />
              </div>
              <span class="pan-label">{toolA}</span>
            </div>
          </div>
          <div class="balance-pan pan-b">
            <span class="pan-strings" />
            <div class="pan-dish">
              <div class="shape shape-b" data-shape={themeB.shape} data-accent={themeB.accent}>
                <Shape shape={themeB.shape} initials={initials(toolB)} />
              </div>
              <span class="pan-label">{toolB}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="balance-meters">
        <div class="meter" data-meter="a-pros">
          <span class="meter-label">{toolA} pros</span>
          <span class="meter-track">
            <span class="meter-fill pros" />
          </span>
          <span class="meter-value">0</span>
        </div>
        <div class="meter" data-meter="b-pros">
          <span class="meter-label">{toolB} pros</span>
          <span class="meter-track">
            <span class="meter-fill pros" />
          </span>
          <span class="meter-value">0</span>
        </div>
        <div class="meter" data-meter="a-cons">
          <span class="meter-label">{toolA} cons</span>
          <span class="meter-track">
            <span class="meter-fill cons" />
          </span>
          <span class="meter-value">0</span>
        </div>
        <div class="meter" data-meter="b-cons">
          <span class="meter-label">{toolB} cons</span>
          <span class="meter-track">
            <span class="meter-fill cons" />
          </span>
          <span class="meter-value">0</span>
        </div>
      </div>
      <p class="stage-hint">Point at a side or hover a spec card to tip the scale</p>
    </div>
  )
}

{
  kind === 'faq' && (
    <div class="tab-stage stage-questions" data-stage="faq" aria-hidden="true">
      <div class="q-field">
        {Array.from({ length: 9 }, (_, i) => (
          <span class="q-glyph" style={`--i: ${i}`}>
            ?
          </span>
        ))}
      </div>
      <p class="stage-hint">Questions lean toward you · open one to light it up</p>
    </div>
  )
}

{
  kind === 'community' && (
    <div class="tab-stage stage-network" data-stage="community" aria-hidden="true">
      <canvas class="network-canvas" />
      <p class="stage-hint">Every dot is a reader · move to connect · click to join in</p>
    </div>
  )
}

<style is:global>
  .tab-stage {
    position: relative;
    height: 170px;
    margin: -8px 0 28px;
    border-radius: 18px;
    overflow: hidden;
    border: 1.5px solid transparent;
    background:
      radial-gradient(circle at 20% 0%, rgba(106, 75, 205, 0.1), transparent 55%) padding-box,
      radial-gradient(circle at 80% 100%, rgba(214, 107, 178, 0.1), transparent 55%) padding-box,
      linear-gradient(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.7)) padding-box,
      var(--z-gradient) border-box;
    cursor: crosshair;
    user-select: none;
    perspective: 900px;
    transform-style: preserve-3d;
  }

  .stage-hint {
    position: absolute;
    right: 14px;
    bottom: 10px;
    margin: 0 !important;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem !important;
    letter-spacing: 0.04em;
    color: var(--z-muted) !important;
    pointer-events: none;
  }

  .stage-ripple {
    position: absolute;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    border-radius: 50%;
    border: 2px solid var(--z-accent);
    pointer-events: none;
  }

  /* ---------- Overview: duel ---------- */
  .duel-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .duel-beam,
  .duel-beam-glow {
    fill: none;
    stroke: url(#duel-grad);
    stroke-linecap: round;
  }

  .duel-beam {
    stroke-width: 3;
    stroke-dasharray: 10 8;
    animation: beam-flow 1.2s linear infinite;
  }

  .duel-beam-glow {
    stroke-width: 14;
    opacity: 0.18;
    filter: blur(4px);
  }

  @keyframes beam-flow {
    to {
      stroke-dashoffset: -36;
    }
  }

  .shape {
    position: absolute;
    top: 50%;
    width: 88px;
    height: 88px;
    margin-top: -54px;
    transform-style: preserve-3d;
    display: grid;
    place-items: center;
    color: #ffffff;
    filter: drop-shadow(0 18px 28px rgba(106, 75, 205, 0.35));
    transition: filter 0.3s ease;
  }

  .shape.shape-a {
    left: 7%;
  }

  .shape.shape-b {
    right: 7%;
  }

  .mono-initials {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  /* Cube */
  .shape[data-shape='cube'] {
    --cube-size: 56px;
    width: var(--cube-size);
    height: var(--cube-size);
  }

  .shape[data-shape='cube'] .face {
    position: absolute;
    width: var(--cube-size);
    height: var(--cube-size);
    border-radius: 8px;
    display: grid;
    place-items: center;
    backface-visibility: visible;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .shape[data-shape='cube'][data-accent='purple'] .face,
  .shape[data-shape='cube']:not([data-accent]) .face {
    background: linear-gradient(135deg, #6a4bcd, #8f6ee6);
  }
  .shape[data-shape='cube'][data-accent='pink'] .face {
    background: linear-gradient(135deg, #d66bb2, #de8ad4);
  }
  .shape[data-shape='cube'][data-accent='lavender'] .face {
    background: linear-gradient(135deg, #9b8be6, #c4b8f6);
  }
  .shape[data-shape='cube'][data-accent='cyan'] .face {
    background: linear-gradient(135deg, #4b90cd, #6ecfe6);
  }

  .shape[data-shape='cube'] .face-front {
    transform: translateZ(calc(var(--cube-size) / 2));
  }
  .shape[data-shape='cube'] .face-back {
    transform: rotateY(180deg) translateZ(calc(var(--cube-size) / 2));
  }
  .shape[data-shape='cube'] .face-right {
    transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2));
  }
  .shape[data-shape='cube'] .face-left {
    transform: rotateY(-90deg) translateZ(calc(var(--cube-size) / 2));
  }
  .shape[data-shape='cube'] .face-top {
    transform: rotateX(90deg) translateZ(calc(var(--cube-size) / 2));
  }
  .shape[data-shape='cube'] .face-bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--cube-size) / 2));
  }

  /* Sphere */
  .shape[data-shape='sphere'] {
    border-radius: 50%;
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
  }
  .shape[data-shape='sphere'] .mono-initials {
    z-index: 2;
  }
  .shape[data-shape='sphere']::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0) 40%),
      linear-gradient(135deg, #d66bb2, #de8ad4);
    box-shadow:
      inset -8px -8px 20px rgba(0, 0, 0, 0.15),
      0 14px 34px -10px rgba(214, 107, 178, 0.45);
  }

  /* Shard */
  .shape[data-shape='shard'] {
    width: 52px;
    height: 72px;
    clip-path: polygon(50% 0%, 100% 35%, 85% 100%, 15% 100%, 0% 35%);
    background: linear-gradient(135deg, #4b90cd, #6ecfe6);
    display: grid;
    place-items: center;
    box-shadow: 0 14px 30px -10px rgba(75, 144, 205, 0.45);
  }

  /* Hex */
  .shape[data-shape='hex'] {
    width: 74px;
    height: 82px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: linear-gradient(135deg, #9b8be6, #c4b8f6);
    display: grid;
    place-items: center;
    box-shadow: 0 14px 30px -10px rgba(155, 139, 230, 0.45);
  }

  /* Layer stack */
  .shape[data-shape='layer'] {
    width: 64px;
    height: 64px;
    transform-style: preserve-3d;
  }
  .shape[data-shape='layer'] .layer {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: linear-gradient(135deg, #6a4bcd, #8f6ee6);
    box-shadow: 0 4px 12px rgba(106, 75, 205, 0.25);
  }
  .shape[data-shape='layer'] .layer-1 {
    transform: translateZ(14px);
  }
  .shape[data-shape='layer'] .layer-2 {
    transform: translateZ(7px);
    opacity: 0.85;
  }
  .shape[data-shape='layer'] .layer-3 {
    transform: translateZ(0px);
    opacity: 0.7;
  }
  .shape[data-shape='layer'] .layer-initials {
    position: absolute;
    z-index: 4;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  /* Neural node */
  .shape[data-shape='node'] {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #ffffff, #de8ad4 40%, #d66bb2 70%);
    box-shadow:
      0 0 0 6px rgba(222, 138, 212, 0.25),
      0 0 0 12px rgba(222, 138, 212, 0.12),
      0 16px 34px -10px rgba(214, 107, 178, 0.45);
    display: grid;
    place-items: center;
  }

  /* Shield */
  .shape[data-shape='shield'] {
    width: 62px;
    height: 70px;
    background: linear-gradient(135deg, #6a4bcd, #8f6ee6);
    clip-path: path('M31 2 L58 14 L58 34 C58 52 31 68 31 68 C31 68 4 52 4 34 L4 14 Z');
    display: grid;
    place-items: center;
    box-shadow: 0 14px 30px -10px rgba(106, 75, 205, 0.45);
  }

  /* Ring / monitor */
  .shape[data-shape='ring'] {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
  }
  .shape[data-shape='ring'] .ring {
    position: absolute;
    border-radius: 50%;
    border: 3px solid rgba(75, 144, 205, 0.6);
  }
  .shape[data-shape='ring'] .ring-1 {
    width: 72px;
    height: 72px;
  }
  .shape[data-shape='ring'] .ring-2 {
    width: 52px;
    height: 52px;
    border-color: rgba(75, 144, 205, 0.4);
  }
  .shape[data-shape='ring'] .ring-3 {
    width: 32px;
    height: 32px;
    background: rgba(75, 144, 205, 0.25);
    border: none;
  }
  .shape[data-shape='ring'] .ring-initials {
    position: absolute;
    z-index: 2;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    color: #2b4c66;
  }

  .duel-spark {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 0 0 4px rgba(222, 138, 212, 0.5),
      0 0 24px 8px rgba(214, 107, 178, 0.55);
    pointer-events: none;
  }

  /* ---------- Specs: balance ---------- */
  .stage-balance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    padding: 0 22px;
  }

  .balance-rig {
    position: relative;
    height: 150px;
    --tilt: 0deg;
  }

  .balance-pillar {
    position: absolute;
    left: 50%;
    top: 34px;
    bottom: 14px;
    width: 6px;
    margin-left: -3px;
    border-radius: 3px;
    background: var(--z-gradient);
  }

  .balance-pillar::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 70px;
    height: 8px;
    margin-left: -35px;
    border-radius: 4px;
    background: var(--z-gradient);
  }

  .balance-beam {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 30px;
    height: 6px;
    border-radius: 3px;
    background: var(--z-gradient);
    rotate: var(--tilt);
    transform-origin: 50% 50%;
  }

  .balance-pan {
    position: absolute;
    top: 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    rotate: calc(var(--tilt) * -1);
    transform-origin: 50% 0;
  }

  .pan-a {
    left: 0;
    translate: -50% 0;
  }

  .pan-b {
    right: 0;
    translate: 50% 0;
  }

  .pan-strings {
    width: 56px;
    height: 34px;
    background:
      linear-gradient(
          to bottom right,
          transparent calc(50% - 1px),
          rgba(106, 75, 205, 0.6) 50%,
          transparent calc(50% + 1px)
        )
        left / 50% 100% no-repeat,
      linear-gradient(
          to bottom left,
          transparent calc(50% - 1px),
          rgba(214, 107, 178, 0.6) 50%,
          transparent calc(50% + 1px)
        )
        right / 50% 100% no-repeat;
  }

  .pan-dish {
    position: relative;
    min-width: 92px;
    max-width: 130px;
    min-height: 74px;
    display: grid;
    place-items: center;
    padding: 8px 10px 22px;
    border-radius: 0 0 40px 40px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(247, 245, 252, 0.55));
    border: 1px solid rgba(106, 75, 205, 0.18);
    box-shadow: 0 12px 24px -12px rgba(106, 75, 205, 0.35);
  }

  .pan-dish .shape {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    margin: -18px 0 -10px;
    transform: scale(0.72);
    filter: drop-shadow(0 8px 14px rgba(106, 75, 205, 0.3));
  }

  .pan-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--z-text);
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .balance-meters {
    display: grid;
    gap: 9px;
    padding-bottom: 14px;
  }

  .meter {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr) 22px;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--z-muted);
  }

  .meter-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meter-track {
    height: 8px;
    border-radius: 999px;
    background: rgba(5, 3, 12, 0.06);
    overflow: hidden;
  }

  .meter-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
  }

  .meter-fill.pros {
    background: linear-gradient(90deg, #6a4bcd, #8f6ee6);
  }

  .meter-fill.cons {
    background: linear-gradient(90deg, #d66bb2, #de8ad4);
  }

  .meter-value {
    font-weight: 700;
    color: var(--z-text);
    text-align: right;
  }

  /* ---------- FAQ: question field ---------- */
  .q-field {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 3%;
    transform-style: preserve-3d;
  }

  .q-glyph {
    display: inline-block;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: calc(2.4rem + (var(--i) * 7 % 5) * 0.45rem);
    line-height: 1;
    background: var(--z-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.45;
    animation: q-bob calc(3s + var(--i) * 0.35s) ease-in-out infinite alternate;
    transition: opacity 0.3s ease;
    transform-style: preserve-3d;
    transform-origin: center center;
    will-change: transform;
  }

  .q-glyph.lit {
    opacity: 1;
    filter: drop-shadow(0 0 12px rgba(214, 107, 178, 0.6));
  }

  @keyframes q-bob {
    from {
      translate: 0 -10px;
    }
    to {
      translate: 0 10px;
    }
  }

  /* ---------- Community: network ---------- */
  .network-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 700px) {
    .tab-stage {
      height: 150px;
    }
    .stage-balance {
      grid-template-columns: 1fr;
    }
    .balance-meters {
      display: none;
    }
    .shape {
      width: 64px;
      height: 64px;
      margin-top: -40px;
    }
    .shape[data-shape='cube'] {
      --cube-size: 44px;
    }
    .shape[data-shape='sphere'] {
      width: 54px;
      height: 54px;
    }
    .shape[data-shape='shard'] {
      width: 40px;
      height: 56px;
    }
    .shape[data-shape='hex'] {
      width: 56px;
      height: 62px;
    }
    .shape[data-shape='layer'] {
      width: 50px;
      height: 50px;
    }
    .shape[data-shape='node'] {
      width: 50px;
      height: 50px;
    }
    .shape[data-shape='shield'] {
      width: 48px;
      height: 54px;
    }
    .shape[data-shape='ring'] {
      width: 56px;
      height: 56px;
    }
    .shape[data-shape='ring'] .ring-1 {
      width: 56px;
      height: 56px;
    }
    .shape[data-shape='ring'] .ring-2 {
      width: 40px;
      height: 40px;
    }
    .shape[data-shape='ring'] .ring-3 {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .duel-beam,
    .q-glyph {
      animation: none;
    }
    .stage-hint {
      display: none;
    }
  }
</style>
