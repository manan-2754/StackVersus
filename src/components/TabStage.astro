---
export interface Props {
  kind: 'overview' | 'specs' | 'faq' | 'community';
  toolA: string;
  toolB: string;
}

const { kind, toolA, toolB } = Astro.props;
const initials = (name: string) =>
  name
    .replace(/[^A-Za-z0-9 ]/g, ' ')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join('') || name.slice(0, 2).toUpperCase();
---

{
  kind === 'overview' && (
    <div class="tab-stage stage-duel" data-stage="overview" aria-hidden="true">
      <svg class="duel-svg">
        <defs>
          <linearGradient id="duel-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#6a4bcd" />
            <stop offset="50%" stop-color="#de8ad4" />
            <stop offset="100%" stop-color="#d66bb2" />
          </linearGradient>
        </defs>
        <path class="duel-beam-glow" />
        <path class="duel-beam" />
      </svg>
      <div class="duel-orb orb-a">
        <span class="orb-initials">{initials(toolA)}</span>
        <span class="orb-name">{toolA}</span>
      </div>
      <div class="duel-spark" />
      <div class="duel-orb orb-b">
        <span class="orb-initials">{initials(toolB)}</span>
        <span class="orb-name">{toolB}</span>
      </div>
      <p class="stage-hint">Move to shift the balance · click to fire a pulse</p>
    </div>
  )
}

{
  kind === 'specs' && (
    <div class="tab-stage stage-balance" data-stage="specs" aria-hidden="true">
      <div class="balance-rig">
        <div class="balance-pillar" />
        <div class="balance-beam">
          <div class="balance-pan pan-a">
            <span class="pan-strings" />
            <span class="pan-dish">{toolA}</span>
          </div>
          <div class="balance-pan pan-b">
            <span class="pan-strings" />
            <span class="pan-dish">{toolB}</span>
          </div>
        </div>
      </div>
      <div class="balance-meters">
        <div class="meter" data-meter="a-pros">
          <span class="meter-label">{toolA} pros</span>
          <span class="meter-track">
            <span class="meter-fill pros" />
          </span>
          <span class="meter-value">0</span>
        </div>
        <div class="meter" data-meter="b-pros">
          <span class="meter-label">{toolB} pros</span>
          <span class="meter-track">
            <span class="meter-fill pros" />
          </span>
          <span class="meter-value">0</span>
        </div>
        <div class="meter" data-meter="a-cons">
          <span class="meter-label">{toolA} cons</span>
          <span class="meter-track">
            <span class="meter-fill cons" />
          </span>
          <span class="meter-value">0</span>
        </div>
        <div class="meter" data-meter="b-cons">
          <span class="meter-label">{toolB} cons</span>
          <span class="meter-track">
            <span class="meter-fill cons" />
          </span>
          <span class="meter-value">0</span>
        </div>
      </div>
      <p class="stage-hint">Point at a side or hover a spec card to tip the scale</p>
    </div>
  )
}

{
  kind === 'faq' && (
    <div class="tab-stage stage-questions" data-stage="faq" aria-hidden="true">
      <div class="q-field">
        {Array.from({ length: 9 }, (_, i) => (
          <span class="q-glyph" style={`--i: ${i}`}>
            ?
          </span>
        ))}
      </div>
      <p class="stage-hint">Questions lean toward you · open one to light it up</p>
    </div>
  )
}

{
  kind === 'community' && (
    <div class="tab-stage stage-network" data-stage="community" aria-hidden="true">
      <canvas class="network-canvas" />
      <p class="stage-hint">Every dot is a reader · move to connect · click to join in</p>
    </div>
  )
}

<style is:global>
  .tab-stage {
    position: relative;
    height: 170px;
    margin: -8px 0 28px;
    border-radius: 18px;
    overflow: hidden;
    border: 1.5px solid transparent;
    background:
      radial-gradient(circle at 20% 0%, rgba(106, 75, 205, 0.1), transparent 55%) padding-box,
      radial-gradient(circle at 80% 100%, rgba(214, 107, 178, 0.1), transparent 55%) padding-box,
      linear-gradient(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.7)) padding-box,
      var(--z-gradient) border-box;
    cursor: crosshair;
    user-select: none;
  }

  .stage-hint {
    position: absolute;
    right: 14px;
    bottom: 10px;
    margin: 0 !important;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem !important;
    letter-spacing: 0.04em;
    color: var(--z-muted) !important;
    pointer-events: none;
  }

  .stage-ripple {
    position: absolute;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    border-radius: 50%;
    border: 2px solid var(--z-accent);
    pointer-events: none;
  }

  /* ---------- Overview: duel ---------- */
  .duel-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .duel-beam,
  .duel-beam-glow {
    fill: none;
    stroke: url(#duel-grad);
    stroke-linecap: round;
  }

  .duel-beam {
    stroke-width: 3;
    stroke-dasharray: 10 8;
    animation: beam-flow 1.2s linear infinite;
  }

  .duel-beam-glow {
    stroke-width: 14;
    opacity: 0.18;
    filter: blur(4px);
  }

  @keyframes beam-flow {
    to {
      stroke-dashoffset: -36;
    }
  }

  .duel-orb {
    position: absolute;
    top: 50%;
    width: 92px;
    height: 92px;
    margin-top: -56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    color: #ffffff;
    box-shadow:
      0 18px 40px -14px rgba(106, 75, 205, 0.6),
      inset 0 2px 0 rgba(255, 255, 255, 0.35);
  }

  .duel-orb.orb-a {
    left: 7%;
    background: linear-gradient(135deg, #6a4bcd, #8f6ee6);
  }

  .duel-orb.orb-b {
    right: 7%;
    background: linear-gradient(135deg, #d66bb2, #de8ad4);
  }

  .orb-initials {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
  }

  .orb-name {
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    opacity: 0.9;
  }

  .duel-spark {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 0 0 4px rgba(222, 138, 212, 0.5),
      0 0 24px 8px rgba(214, 107, 178, 0.55);
    pointer-events: none;
  }

  /* ---------- Specs: balance ---------- */
  .stage-balance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    padding: 0 22px;
  }

  .balance-rig {
    position: relative;
    height: 150px;
    --tilt: 0deg;
  }

  .balance-pillar {
    position: absolute;
    left: 50%;
    top: 34px;
    bottom: 14px;
    width: 6px;
    margin-left: -3px;
    border-radius: 3px;
    background: var(--z-gradient);
  }

  .balance-pillar::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 70px;
    height: 8px;
    margin-left: -35px;
    border-radius: 4px;
    background: var(--z-gradient);
  }

  .balance-beam {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 30px;
    height: 6px;
    border-radius: 3px;
    background: var(--z-gradient);
    rotate: var(--tilt);
    transform-origin: 50% 50%;
  }

  .balance-pan {
    position: absolute;
    top: 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    rotate: calc(var(--tilt) * -1);
    transform-origin: 50% 0;
  }

  .pan-a {
    left: 0;
    translate: -50% 0;
  }

  .pan-b {
    right: 0;
    translate: 50% 0;
  }

  .pan-strings {
    width: 56px;
    height: 34px;
    background:
      linear-gradient(
          to bottom right,
          transparent calc(50% - 1px),
          rgba(106, 75, 205, 0.6) 50%,
          transparent calc(50% + 1px)
        )
        left / 50% 100% no-repeat,
      linear-gradient(
          to bottom left,
          transparent calc(50% - 1px),
          rgba(214, 107, 178, 0.6) 50%,
          transparent calc(50% + 1px)
        )
        right / 50% 100% no-repeat;
  }

  .pan-dish {
    min-width: 86px;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
    padding: 6px 10px;
    border-radius: 0 0 40px 40px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--z-gradient);
    box-shadow: 0 10px 20px -10px rgba(106, 75, 205, 0.7);
  }

  .balance-meters {
    display: grid;
    gap: 9px;
    padding-bottom: 14px;
  }

  .meter {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr) 22px;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--z-muted);
  }

  .meter-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meter-track {
    height: 8px;
    border-radius: 999px;
    background: rgba(5, 3, 12, 0.06);
    overflow: hidden;
  }

  .meter-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
  }

  .meter-fill.pros {
    background: linear-gradient(90deg, #6a4bcd, #8f6ee6);
  }

  .meter-fill.cons {
    background: linear-gradient(90deg, #d66bb2, #de8ad4);
  }

  .meter-value {
    font-weight: 700;
    color: var(--z-text);
    text-align: right;
  }

  /* ---------- FAQ: question field ---------- */
  .q-field {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 3%;
  }

  .q-glyph {
    display: inline-block;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: calc(2.4rem + (var(--i) * 7 % 5) * 0.45rem);
    line-height: 1;
    background: var(--z-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.45;
    animation: q-bob calc(3s + var(--i) * 0.35s) ease-in-out infinite alternate;
    transition: opacity 0.3s ease;
  }

  .q-glyph.lit {
    opacity: 1;
    filter: drop-shadow(0 0 12px rgba(214, 107, 178, 0.6));
  }

  @keyframes q-bob {
    from {
      translate: 0 -10px;
    }
    to {
      translate: 0 10px;
    }
  }

  /* ---------- Community: network ---------- */
  .network-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 700px) {
    .tab-stage {
      height: 150px;
    }
    .stage-balance {
      grid-template-columns: 1fr;
    }
    .balance-meters {
      display: none;
    }
    .duel-orb {
      width: 72px;
      height: 72px;
      margin-top: -44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .duel-beam,
    .q-glyph {
      animation: none;
    }
    .stage-hint {
      display: none;
    }
  }
</style>
