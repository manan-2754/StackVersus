---

---

<div id="command-palette" class="cmd-palette" role="dialog" aria-modal="true" aria-label="Command palette" hidden>
  <div class="cmd-backdrop" data-cmd-close></div>
  <div class="cmd-panel motion-scale-in">
    <div class="cmd-input-row">
      <span class="cmd-icon" aria-hidden="true">⌕</span>
      <input
        id="cmd-input"
        type="text"
        class="cmd-input"
        placeholder="Search comparisons, categories, tools..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmd-hint">ESC</kbd>
    </div>
    <div id="cmd-results" class="cmd-results" role="listbox"></div>
    <div class="cmd-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
      <span><kbd>↵</kbd> Open</span>
    </div>
  </div>
</div>

<script>
  type SearchItem = { title: string; slug: string; category: string; description: string };

  let index: SearchItem[] = [];
  let selected = 0;
  const palette = document.getElementById('command-palette') as HTMLDivElement;
  const input = document.getElementById('cmd-input') as HTMLInputElement;
  const results = document.getElementById('cmd-results') as HTMLDivElement;

  async function loadIndex() {
    try {
      const res = await fetch('/search.json');
      index = (await res.json()) as SearchItem[];
    } catch {
      index = [];
    }
  }

  function openPalette() {
    palette.hidden = false;
    input.value = '';
    renderResults([]);
    input.focus();
    document.body.style.overflow = 'hidden';
  }

  function closePalette() {
    palette.hidden = true;
    document.body.style.overflow = '';
  }

  function renderResults(items: SearchItem[]) {
    selected = 0;
    results.innerHTML = items
      .map(
        (item, i) => `
        <a class="cmd-result ${i === 0 ? 'selected' : ''}" href="/comparisons/${item.slug}/" role="option" data-index="${i}">
          <div class="cmd-result-title">${escapeHtml(item.title)}</div>
          <div class="cmd-result-meta">${escapeHtml(item.category)} · ${escapeHtml(item.description.slice(0, 70))}…</div>
        </a>
      `
      )
      .join('');
    if (items.length === 0) {
      results.innerHTML = '<div class="cmd-empty">No matches. Try a different query.</div>';
    }
  }

  function escapeHtml(str: string) {
    return str.replace(
      /[&<>"']/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] || c
    );
  }

  function updateSelection(delta: number) {
    const items = results.querySelectorAll<HTMLElement>('.cmd-result');
    if (!items.length) return;
    items[selected]?.classList.remove('selected');
    selected = (selected + delta + items.length) % items.length;
    items[selected].classList.add('selected');
    items[selected].scrollIntoView({ block: 'nearest' });
  }

  function search(query: string) {
    const q = query.toLowerCase().trim();
    if (!q) return renderResults([]);
    const ranked = index
      .map((item) => {
        const title = item.title.toLowerCase();
        const cat = item.category.toLowerCase();
        let score = 0;
        if (title.startsWith(q)) score += 4;
        if (title.includes(q)) score += 2;
        if (cat.includes(q)) score += 1;
        return { item, score };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8)
      .map((r) => r.item);
    renderResults(ranked);
  }

  input.addEventListener('input', (e) => search((e.target as HTMLInputElement).value));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      updateSelection(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      updateSelection(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const link = results.querySelector<HTMLAnchorElement>('.cmd-result.selected, .cmd-result:first-child');
      if (link) window.location.href = link.href;
    } else if (e.key === 'Escape') {
      closePalette();
    }
  });

  palette.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.hasAttribute('data-cmd-close')) closePalette();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openPalette();
    } else if (e.key === 'Escape' && !palette.hidden) {
      closePalette();
    }
  });

  loadIndex();
</script>

<style is:global>
  .cmd-palette {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .cmd-palette[hidden] {
    display: none;
  }

  .cmd-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 3, 12, 0.35);
    backdrop-filter: blur(4px);
  }

  .cmd-panel {
    position: relative;
    width: min(680px, 92vw);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--z-border);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(5, 3, 12, 0.18);
    overflow: hidden;
  }

  .cmd-input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--z-border);
  }

  .cmd-icon {
    font-size: 1.2rem;
    color: var(--z-muted);
  }

  .cmd-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1rem;
    color: var(--z-text);
    outline: none;
  }

  .cmd-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--z-muted);
    background: var(--z-surface);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--z-border);
  }

  .cmd-results {
    max-height: 320px;
    overflow-y: auto;
    padding: 8px;
  }

  .cmd-result {
    display: block;
    padding: 12px 14px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cmd-result.selected,
  .cmd-result:hover,
  .cmd-result:focus-visible {
    background: rgba(106, 75, 205, 0.08);
    outline: none;
  }

  .cmd-result-title {
    font-weight: 600;
    color: var(--z-text);
    margin-bottom: 2px;
  }

  .cmd-result-meta {
    font-size: 0.8rem;
    color: var(--z-muted);
  }

  .cmd-empty {
    padding: 24px;
    text-align: center;
    color: var(--z-muted);
    font-size: 0.9rem;
  }

  .cmd-footer {
    display: flex;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--z-border);
    font-size: 0.75rem;
    color: var(--z-muted);
  }

  .cmd-footer kbd {
    font-family: 'JetBrains Mono', monospace;
    background: var(--z-surface);
    border: 1px solid var(--z-border);
    border-radius: 4px;
    padding: 2px 6px;
    margin-right: 4px;
  }
</style>
