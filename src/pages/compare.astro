---
import BaseLayout from '../layouts/BaseLayout.astro';
import HudBar from '../components/HudBar.astro';
import Footer from '../components/Footer.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://stackversus.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Compare', item: 'https://stackversus.pages.dev/compare/' },
  ],
};
---

<BaseLayout
  robots="noindex, follow"
  title="Compare — StackVersus"
  description="Pick two developer tool comparisons and review them side-by-side."
  canonical="https://stackversus.pages.dev/compare/"
  schema={breadcrumbSchema}
>
  <div class="viewport-wrapper">
    <HudBar left="Compare Mode" center="Engine: StackVersus Matrix" right="State: Interactive" />

    <header class="motion-fade-up">
      <span class="hero-tag">// Side-by-Side</span>
      <h1>
        Compare <span class="kinetic-gradient">Anything</span>
      </h1>
      <p>Select two comparisons to inspect their descriptions, categories, and direct links side-by-side.</p>
    </header>

    <div class="controls motion-fade-up" id="main-content">
      <div class="picker">
        <label for="compare-a">Comparison A</label>
        <select id="compare-a"><option value="">Choose a comparison</option></select>
      </div>
      <div class="vs">VS</div>
      <div class="picker">
        <label for="compare-b">Comparison B</label>
        <select id="compare-b"><option value="">Choose a comparison</option></select>
      </div>
    </div>

    <main class="arena">
      <article id="card-a" class="compare-card" hidden>
        <div class="card-category" id="cat-a"></div>
        <h2 id="title-a"></h2>
        <p id="desc-a"></p>
        <a id="link-a" href="#" class="cta">Open comparison →</a>
      </article>

      <article id="card-b" class="compare-card" hidden>
        <div class="card-category" id="cat-b"></div>
        <h2 id="title-b"></h2>
        <p id="desc-b"></p>
        <a id="link-b" href="#" class="cta">Open comparison →</a>
      </article>
    </main>

    <Footer />
  </div>

  <script>
    type Item = { slug: string; title: string; description: string; category: string; tool_a: string; tool_b: string };

    let data: Item[] = [];
    const selectA = document.getElementById('compare-a') as HTMLSelectElement;
    const selectB = document.getElementById('compare-b') as HTMLSelectElement;

    async function load() {
      try {
        const res = await fetch('/search.json');
        data = (await res.json()) as Item[];
        const options = data
          .sort((a, b) => a.title.localeCompare(b.title))
          .map((item) => `<option value="${item.slug}">${item.title}</option>`)
          .join('');
        selectA.innerHTML = '<option value="">Choose a comparison</option>' + options;
        selectB.innerHTML = selectA.innerHTML;

        const params = new URLSearchParams(window.location.search);
        const aSlug = params.get('a');
        const bSlug = params.get('b');
        if (aSlug) {
          selectA.value = aSlug;
          renderCard('a', aSlug);
        }
        if (bSlug) {
          selectB.value = bSlug;
          renderCard('b', bSlug);
        }
      } catch {
        // silent
      }
    }

    function renderCard(side: 'a' | 'b', slug: string) {
      const item = data.find((d) => d.slug === slug);
      const card = document.getElementById(`card-${side}`) as HTMLElement;
      if (!item) {
        card.hidden = true;
        return;
      }
      document.getElementById(`cat-${side}`)!.textContent = item.category;
      document.getElementById(`title-${side}`)!.textContent = item.title;
      document.getElementById(`desc-${side}`)!.textContent = item.description;
      const link = document.getElementById(`link-${side}`) as HTMLAnchorElement;
      link.href = `/comparisons/${item.slug}/`;
      card.hidden = false;
      card.classList.add('motion-scale-in');
      setTimeout(() => card.classList.remove('motion-scale-in'), 500);
      updateUrl();
    }

    function updateUrl() {
      const params = new URLSearchParams();
      if (selectA.value) params.set('a', selectA.value);
      if (selectB.value) params.set('b', selectB.value);
      const next = params.toString() ? '?' + params.toString() : '';
      window.history.replaceState(null, '', window.location.pathname + next);
    }

    selectA.addEventListener('change', () => renderCard('a', selectA.value));
    selectB.addEventListener('change', () => renderCard('b', selectB.value));

    load();
  </script>

  <style>
    header {
      margin: clamp(24px, 4vw, 44px) 0 clamp(20px, 3vw, 32px);
    }
    .hero-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(0.72rem, 1.2vw, 0.8rem);
      color: var(--z-primary);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
      display: inline-block;
    }
    h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2rem, 5vw, 4.4rem);
      font-weight: 800;
      line-height: 1.06;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      color: var(--z-text);
    }
    h1 .kinetic-gradient {
      background: linear-gradient(90deg, var(--z-primary) 10%, var(--z-accent) 55%, var(--z-secondary) 100%);
      background-size: 200% auto;
      animation: gradient-shift 5s ease infinite;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    header p {
      font-size: clamp(0.92rem, 1.6vw, 1.05rem);
      color: var(--z-muted);
      max-width: 620px;
      margin-top: 14px;
      line-height: 1.6;
    }
    .controls {
      display: flex;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 34px;
    }
    .picker {
      flex: 1;
      min-width: 240px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .picker label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--z-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .picker select {
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid var(--z-border);
      background: var(--z-surface);
      color: var(--z-text);
      font-size: 0.92rem;
      outline: none;
      cursor: pointer;
    }
    .picker select:focus {
      border-color: var(--z-primary);
      box-shadow: 0 0 12px var(--z-primary-glow);
    }
    .vs {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: var(--z-accent);
      padding-bottom: 10px;
    }
    .arena {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 80px;
    }
    .compare-card {
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-radius: 18px;
      padding: 28px;
      transition: all 0.25s ease;
    }
    .compare-card:hover {
      border-color: var(--z-border-glow);
      box-shadow: 0 20px 40px rgba(5, 3, 12, 0.1);
    }
    .card-category {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--z-primary);
      background: rgba(106, 75, 205, 0.1);
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 14px;
    }
    .compare-card h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--z-text);
      margin-bottom: 10px;
    }
    .compare-card p {
      font-size: 0.92rem;
      color: var(--z-muted);
      line-height: 1.6;
      margin-bottom: 20px;
    }
    .cta {
      display: inline-flex;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      font-weight: 700;
      color: #ffffff;
      background: var(--z-primary);
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .cta:hover,
    .cta:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(106, 75, 205, 0.25);
      outline: none;
    }
    @media (max-width: 900px) {
      .arena {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
