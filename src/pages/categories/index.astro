---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudBar from '../../components/HudBar.astro';
import Footer from '../../components/Footer.astro';

const allComparisons = await getCollection('comparisons');

const categoryMap = new Map<string, number>();
allComparisons.forEach((item) => {
  const cat = item.data.category || 'Developer Tools';
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});

const categories = [...categoryMap.entries()].sort((a, b) => b[1] - a[1]);

const siteUrl = 'https://stackversus.pages.dev';

function slugifyCategory(cat: string) {
  return cat
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Categories',
      item: `${siteUrl}/categories/`,
    },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'StackVersus Software Comparison Categories',
  description: 'Browse developer tool comparison categories.',
  url: `${siteUrl}/categories/`,
  numberOfItems: categories.length,
};
---

<BaseLayout
  title="Categories — StackVersus"
  description="Browse all software comparison categories on StackVersus, from databases and DevOps to AI tools and frontend frameworks."
  canonical={`${siteUrl}/categories/`}
  ogType="website"
  schema={[schema, breadcrumbSchema]}
>
  <div class="viewport-wrapper">
    <HudBar left="StackVersus // Category Index" right={`Total Categories: ${categories.length}`} />

    <header id="main-content">
      <h1>
        Browse by <span class="category-highlight">Category</span>
      </h1>
      <p>Explore developer tool comparisons grouped by engineering domain.</p>
    </header>

    <main class="grid">
      {
        categories.map(([name, count]) => {
          const slug = slugifyCategory(name);
          return (
            <a href={`/categories/${slug}/`} class="card stack-3d">
              <div>
                <h2>{name}</h2>
                <p>
                  {count} comparison{count === 1 ? '' : 's'}
                </p>
              </div>
              <span class="action-pill stack-cta">
                View Comparisons <span class="arrow">→</span>
              </span>
            </a>
          );
        })
      }
    </main>

    <Footer />
  </div>

  <style>
    header {
      margin: clamp(24px, 4vw, 44px) 0 clamp(28px, 4vw, 48px);
    }

    h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.2rem, 4.5vw, 3.8rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.03em;
      text-transform: uppercase;
      color: var(--z-text);
    }

    .category-highlight {
      color: var(--z-primary);
    }

    header p {
      font-size: 1.05rem;
      color: var(--z-muted);
      max-width: 600px;
      margin-top: 12px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 22px;
    }

    .card {
      background: var(--z-card);
      border: 1px solid var(--z-border);
      border-radius: 18px;
      padding: 26px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition:
        transform 0.3s ease,
        border-color 0.3s ease;
      min-height: 160px;
    }

    .card:hover,
    .card:focus-visible {
      background: var(--z-card-hover);
      outline: none;
    }

    .card h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--z-text);
      margin-bottom: 8px;
    }

    .card p {
      font-size: 0.9rem;
      color: var(--z-muted);
      margin-bottom: 22px;
    }

    .action-pill {
      align-self: flex-start;
    }

    @media (max-width: 640px) {
      .viewport-wrapper {
        width: 92%;
      }
    }
  </style>
</BaseLayout>
