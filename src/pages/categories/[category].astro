---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudBar from '../../components/HudBar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const allComparisons = await getCollection('comparisons');

  const categories = [...new Set(allComparisons.map((item) => item.data.category || 'Developer Tools'))];

  return categories.map((cat) => {
    const slug = cat
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
    return {
      params: { category: slug },
      props: {
        categoryName: cat,
        items: allComparisons.filter((item) => (item.data.category || 'Developer Tools') === cat),
      },
    };
  });
}

const { categoryName, items } = Astro.props;
const siteUrl = 'https://stackversus.pages.dev';
const pageUrl = `${siteUrl}/categories/${categoryName
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '')}/`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${categoryName} Software Comparisons`,
  description: `Compare architectural benchmarks and pricing models for tools in ${categoryName}.`,
  numberOfItems: items.length,
  url: pageUrl,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Categories',
      item: `${siteUrl}/categories/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryName,
      item: pageUrl,
    },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteUrl}/comparisons/${item.id.replace(/\.md$/, '')}/`,
    name: item.data.title,
  })),
};
---

<BaseLayout
  title={`${categoryName} Comparisons & Benchmarks — StackVersus`}
  description={`Explore in-depth technical comparisons, pros, cons, and pricing for ${categoryName} software.`}
  canonical={pageUrl}
  ogType="website"
  schema={[collectionSchema, breadcrumbSchema, itemListSchema]}
>
  <div class="viewport-wrapper">
    <HudBar left="StackVersus // Category Index" right={`Total Comparisons: ${items.length}`} />

    <nav class="subnav" aria-label="Breadcrumb">
      <a href="/" class="back-btn">
        <span aria-hidden="true">←</span>
        <span>Back to Main Arena</span>
      </a>
    </nav>

    <header id="main-content">
      <h1>
        Top <span class="category-highlight">{categoryName}</span> Tools
      </h1>
      <p>
        Explore {items.length} head-to-head {categoryName.toLowerCase()} comparisons. Each benchmark covers performance, pricing,
        architecture, and the ideal use case so you can pick the right tool the first time.
      </p>
    </header>

    <main class="grid">
      {
        items.map((item) => (
          <a href={`/comparisons/${item.id.replace(/\.md$/, '')}/`} class="card stack-3d">
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
            <span class="card-cta stack-cta">
              Open comparison <span class="arrow">→</span>
            </span>
          </a>
        ))
      }
    </main>

    <Footer />
  </div>

  <style>
    .subnav {
      margin: 28px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    header {
      margin-bottom: 40px;
    }

    h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.2rem, 4.5vw, 3.8rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.03em;
      text-transform: uppercase;
      color: var(--z-text);
    }

    .category-highlight {
      color: var(--z-primary);
    }

    header p {
      font-size: 1.05rem;
      color: var(--z-muted);
      max-width: 600px;
      margin-top: 12px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 22px;
    }

    .card {
      background: var(--z-card);
      border: 1px solid var(--z-border);
      border-radius: 18px;
      padding: 26px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition:
        transform 0.3s ease,
        border-color 0.3s ease;
    }

    .card:hover,
    .card:focus-visible {
      background: var(--z-card-hover);
      outline: none;
    }

    .card h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--z-text);
      margin-bottom: 10px;
    }

    .card p {
      font-size: 0.9rem;
      color: var(--z-muted);
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .card-cta {
      align-self: flex-start;
    }
  </style>
</BaseLayout>
