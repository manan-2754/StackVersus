---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudBar from '../../components/HudBar.astro';
import Footer from '../../components/Footer.astro';
import { getTools } from '../../data/tools';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((tool) => ({ params: { tool: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
if (!tool) return Astro.redirect('/tools/');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://stackversus.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://stackversus.pages.dev/tools/' },
    { '@type': 'ListItem', position: 3, name: tool.name, item: `https://stackversus.pages.dev/tools/${tool.slug}/` },
  ],
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: tool.categories[0] || 'DeveloperApplication',
  url: tool.officialUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout
  title={`${tool.name} — Tool Profile & Comparisons`}
  description={`Compare ${tool.name} against alternatives. Reviews, specs, pricing, and community notes on StackVersus.`}
  canonical={`https://stackversus.pages.dev/tools/${tool.slug}/`}
  schema={[breadcrumbSchema, softwareAppSchema]}
>
  <div class="viewport-wrapper">
    <HudBar left="Tool Profile" center="Engine: StackVersus Matrix" right={`ID: ${tool.slug}`} />

    <header class="motion-fade-up">
      <div class="tool-header">
        <div class="tool-avatar">{tool.name.slice(0, 2).toUpperCase()}</div>
        <div>
          <span class="hero-tag">// {tool.categories[0] || 'Developer Tool'}</span>
          <h1>{tool.name}</h1>
        </div>
      </div>
      <p>{tool.description}</p>
      {
        tool.officialUrl && (
          <a
            href={tool.officialUrl}
            class="official-link"
            target="_blank"
            rel="noopener noreferrer nofollow"
            data-track="outbound"
          >
            Visit official site →
          </a>
        )
      }
    </header>

    <main class="content-grid" id="main-content">
      <section class="panel comparisons">
        <h2>Head-to-Head Comparisons</h2>
        <div class="comparison-list">
          {
            tool.comparisons.map((c) => (
              <a href={`/comparisons/${c.slug}/`} class="row">
                <span class="row-title">{c.title}</span>
                <span class="row-opponent">vs {c.opponent}</span>
                <span class="row-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <aside class="panel stats">
        <h2>Profile Stats</h2>
        <dl>
          <div class="stat-row">
            <dt>Comparisons</dt>
            <dd>{tool.comparisons.length}</dd>
          </div>
          <div class="stat-row">
            <dt>Categories</dt>
            <dd>{tool.categories.length}</dd>
          </div>
          <div class="stat-row">
            <dt>Official</dt>
            <dd>{tool.officialUrl ? 'Yes' : 'N/A'}</dd>
          </div>
        </dl>
        <div class="tags">
          {tool.tags.map((tag) => <span class="tag">{tag}</span>)}
          {tool.tags.length === 0 && <span class="tag">{tool.name}</span>}
        </div>
      </aside>
    </main>

    <Footer />
  </div>

  <style>
    header {
      margin: clamp(24px, 4vw, 44px) 0 clamp(28px, 4vw, 42px);
    }
    .tool-header {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: 14px;
    }
    .tool-avatar {
      width: 64px;
      height: 64px;
      border-radius: 16px;
      background: var(--z-gradient);
      background-size: 200% 200%;
      animation: gradient-shift 4s ease infinite;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 1.4rem;
      color: #ffffff;
    }
    .hero-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--z-primary);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.2rem, 4.5vw, 3.8rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      text-transform: uppercase;
      color: var(--z-text);
    }
    header p {
      color: var(--z-muted);
      max-width: 640px;
      margin-bottom: 16px;
      line-height: 1.6;
    }
    .official-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--z-primary);
      text-decoration: none;
      padding: 8px 16px;
      border: 1px solid var(--z-border);
      border-radius: 999px;
      background: var(--z-surface);
      transition: all 0.2s ease;
    }
    .official-link:hover,
    .official-link:focus-visible {
      background: var(--z-primary);
      color: #ffffff;
      border-color: var(--z-primary);
      outline: none;
    }
    .content-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 28px;
      margin-bottom: 80px;
    }
    .panel {
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-radius: 18px;
      padding: 28px;
    }
    .panel h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--z-text);
      margin-bottom: 18px;
      text-transform: uppercase;
    }
    .comparison-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 12px;
      background: rgba(5, 3, 12, 0.03);
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .row:hover,
    .row:focus-visible {
      background: rgba(106, 75, 205, 0.08);
      outline: none;
    }
    .row-title {
      flex: 1;
      font-weight: 600;
      color: var(--z-text);
      font-size: 0.95rem;
    }
    .row-opponent {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--z-muted);
    }
    .row-arrow {
      color: var(--z-primary);
    }
    dl {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
      border-bottom: 1px solid var(--z-border);
      padding-bottom: 10px;
    }
    .stat-row dt {
      color: var(--z-muted);
    }
    .stat-row dd {
      font-weight: 700;
      color: var(--z-text);
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      color: var(--z-primary);
      background: rgba(106, 75, 205, 0.1);
      padding: 4px 10px;
      border-radius: 999px;
    }
    @media (max-width: 900px) {
      .content-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
