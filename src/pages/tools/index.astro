---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudBar from '../../components/HudBar.astro';
import Footer from '../../components/Footer.astro';
import { getTools } from '../../data/tools';

const tools = await getTools();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://stackversus.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://stackversus.pages.dev/tools/' },
  ],
};
---

<BaseLayout
  title="Tool Hub — StackVersus"
  description="Explore every developer tool covered on StackVersus. Find comparisons, specs, and community notes."
  canonical="https://stackversus.pages.dev/tools/"
  schema={breadcrumbSchema}
>
  <div class="viewport-wrapper">
    <HudBar left="Tool Hub" center="Engine: StackVersus Matrix" right="State: Indexed" />

    <header class="motion-fade-up">
      <span class="hero-tag">// Tool Profiles</span>
      <h1>
        Every Tool. <span class="kinetic-gradient">Every Stack.</span>
      </h1>
      <p>
        Browse {tools.length} developer tools and frameworks. Each profile links to every head-to-head comparison we publish.
      </p>
    </header>

    <main class="grid" id="main-content">
      {
        tools.map((tool, i) => (
          <a
            href={`/tools/${tool.slug}/`}
            class="card stack-3d motion-fade-up"
            style={`animation-delay: ${Math.min(i, 16) * 0.03}s`}
          >
            <div class="card-meta">
              <span class="tool-name">{tool.name}</span>
              <span class="tool-count">
                {tool.comparisons.length} comparison{tool.comparisons.length === 1 ? '' : 's'}
              </span>
            </div>
            <p class="tool-desc">{tool.description}</p>
            {tool.categories.length > 0 && (
              <div class="tool-tags">
                {tool.categories.map((c) => (
                  <span class="tool-tag">{c}</span>
                ))}
              </div>
            )}
            <span class="tool-cta stack-cta">
              View profile <span class="arrow">→</span>
            </span>
          </a>
        ))
      }
    </main>

    <Footer />
  </div>

  <style>
    header {
      margin: clamp(24px, 4vw, 44px) 0 clamp(28px, 4vw, 42px);
    }
    .hero-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(0.72rem, 1.2vw, 0.8rem);
      color: var(--z-primary);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
      display: inline-block;
    }
    h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2rem, 5vw, 4.4rem);
      font-weight: 800;
      line-height: 1.06;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      color: var(--z-text);
      word-break: break-word;
    }
    h1 .kinetic-gradient {
      background: linear-gradient(90deg, var(--z-primary) 10%, var(--z-accent) 55%, var(--z-secondary) 100%);
      background-size: 200% auto;
      animation: gradient-shift 5s ease infinite;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    header p {
      font-size: clamp(0.92rem, 1.6vw, 1.05rem);
      color: var(--z-muted);
      max-width: 620px;
      margin-top: 14px;
      line-height: 1.6;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 22px;
      margin-bottom: 80px;
    }
    .card {
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-radius: 18px;
      padding: 24px;
      text-decoration: none;
      transition:
        transform 0.25s var(--z-ease-out),
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
    }
    .card:hover,
    .card:focus-visible {
      background: var(--z-surface-hover);
      outline: none;
    }
    .card {
      display: flex;
      flex-direction: column;
    }
    .tool-cta {
      align-self: flex-start;
      margin-top: auto;
    }
    .tool-tags {
      margin-bottom: 18px;
    }
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .tool-name {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--z-text);
    }
    .tool-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: var(--z-primary);
      background: rgba(106, 75, 205, 0.1);
      padding: 4px 8px;
      border-radius: 999px;
    }
    .tool-desc {
      font-size: 0.88rem;
      color: var(--z-muted);
      line-height: 1.55;
      margin-bottom: 16px;
    }
    .tool-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .tool-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      color: var(--z-muted);
      background: rgba(5, 3, 12, 0.04);
      padding: 4px 8px;
      border-radius: 6px;
    }
    @media (max-width: 640px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
