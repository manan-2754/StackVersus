---
import ContentPage from '../layouts/ContentPage.astro';

const siteUrl = 'https://stackversus.pages.dev';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About',
      item: `${siteUrl}/about`,
    },
  ],
};
---

<ContentPage
  title="About StackVersus — Kinetic Benchmark Engine"
  description="Learn how StackVersus delivers unbiased, data-driven software comparisons and developer architecture benchmarks."
  canonical={`${siteUrl}/about`}
  schema={breadcrumbSchema}
>
  <h1 slot="heading">About StackVersus</h1>

  <p>
    StackVersus is an independent developer intelligence platform engineered to eliminate analysis paralysis when
    evaluating cloud tools, modern databases, and production software infrastructure.
  </p>

  <h2>Our Mission</h2>
  <p>
    Choosing between developer stacks, cloud infrastructure providers, and modern SaaS tools usually requires wading
    through marketing hype and vague pricing tiers. StackVersus audits and standardizes direct head-to-head comparisons
    focusing strictly on architectural fit, developer experience, and cost curves at scale.
  </p>

  <h2>Benchmarking Methodology</h2>
  <p>Every comparison in our matrix is cross-evaluated across four core pillars:</p>
  <ul>
    <li>
      <strong>Architecture & Runtime:</strong> Evaluated on compute footprint, cold start latencies, memory utilization, connection
      pooling limits, and self-hosting escape hatches.
    </li>
    <li>
      <strong>Developer Experience (DX):</strong> Setup friction, CLI ergonomics, SDK ergonomics across TypeScript/Go/Python,
      and migration complexity.
    </li>
    <li>
      <strong>Transparent Cost Audits:</strong> Real-world monthly estimates accounting for hidden egress bandwidth fees,
      seat minimums, and compute overages.
    </li>
    <li>
      <strong>Multi-Agent Verification:</strong> Technical consistency scored across Google Gemini, Meta LLaMA 3.3, and verified
      open-source documentation.
    </li>
  </ul>

  <!-- Targeted Anchor for Footer Link -->
  <div class="disclosure-box" id="disclosure">
    <h2>Affiliate Disclosure & Editorial Independence</h2>
    <p>
      StackVersus is reader-supported. Some links on our comparison tables and action buttons are affiliate tracking
      links, meaning we may earn a referral commission if you subscribe to a paid plan at no additional cost to you.
    </p>
    <p style="margin-bottom: 0;">
      However, our rankings, pros/cons, and technical assessments are generated using objective criteria and verified
      architectural specs. They are never influenced, altered, or dictated by commercial affiliate partnerships.
    </p>
  </div>

  <h2>Contact & Editorial Corrections</h2>
  <p>
    Notice an outdated pricing tier, changed rate limit, or new SDK release? Send correction details directly to our
    research pipeline at <strong style="color: var(--z-lime); font-family: 'JetBrains Mono', monospace;"
      >team@stackversus.pages.dev</strong
    >.
  </p>

  <style slot="after-panel">
    .disclosure-box {
      margin: 36px 0 20px;
      padding: 24px 28px;
      background: var(--z-surface);
      border: 1px solid rgba(106, 75, 205, 0.2);
      border-left: 4px solid var(--z-primary);
      border-radius: 12px;
      scroll-margin-top: 40px;
    }
    .disclosure-box h2 {
      margin-top: 0;
      color: var(--z-text);
      font-size: 1.25rem;
    }
  </style>
</ContentPage>
