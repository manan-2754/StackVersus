---
import ContentPage from '../layouts/ContentPage.astro';

const siteUrl = 'https://stackversus.pages.dev';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Editorial Policy',
      item: `${siteUrl}/editorial-policy`,
    },
  ],
};
---

<ContentPage
  title="Editorial Policy & Methodology — StackVersus"
  description="Read StackVersus's editorial integrity guidelines, evaluation methodology, and affiliate disclosure."
  canonical={`${siteUrl}/editorial-policy`}
  schema={breadcrumbSchema}
>
  <h1 slot="heading">Editorial Policy & Methodology</h1>

  <h2>Objective Benchmarking Standards</h2>
  <p>
    StackVersus maintains strict editorial independence. Our evaluations prioritize open-source availability, verifiable
    latency, community adoption, and predictable billing curves over proprietary claims.
  </p>

  <h2>Continuous Data Verification</h2>
  <p>
    Developer tooling changes rapidly. We continuously audit software documentation, changelogs, and pricing structures
    through automated validation pipelines to keep comparison specs accurate.
  </p>

  <div class="disclosure-box">
    <strong style="color: var(--z-coral); display: block; margin-bottom: 6px;">Affiliate Disclosure</strong>
    StackVersus participates in select partner referral programs. When you click outbound referral links to try tools, we
    may earn a modest commission at no additional cost to you. This does not influence our architectural scoring or feature
    comparisons.
  </div>

  <style slot="after-panel">
    .disclosure-box {
      background: rgba(214, 107, 178, 0.08);
      border: 1px solid rgba(214, 107, 178, 0.3);
      border-radius: 12px;
      padding: 16px 20px;
      margin-top: 24px;
      font-size: 0.92rem;
      color: var(--z-muted);
    }
  </style>
</ContentPage>
