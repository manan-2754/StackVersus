---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('comparisons');
  return posts.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} — StackVersus</title>
    <meta name="description" content={entry.data.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        --off-black: #0d100e;
        --forest-deep: #132a21;
        --forest-emerald: #1B4D3E;
        --cream-light: #FBF9F5;
        --cream-body: #E7E3D8;
        --cream-muted: #9E9B8F;
        --sunset-coral: #FF5A36;
        --coral-glow: rgba(255, 90, 54, 0.28);
        --metallic-gold: #E5B869;
        --gold-glow: rgba(229, 184, 105, 0.22);
        --glass-surface: rgba(19, 27, 23, 0.72);
        --glass-border: rgba(229, 184, 105, 0.18);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        background-color: var(--off-black);
        color: var(--cream-body);
        line-height: 1.8;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* Ambient Background Glow */
      .ambient-glow {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(140px);
        opacity: 0.38;
      }
      .orb-forest { width: 700px; height: 700px; top: -120px; left: -100px; background: radial-gradient(circle, var(--forest-emerald), #0a1f18 70%); }
      .orb-gold { width: 500px; height: 500px; top: 30%; right: -100px; background: radial-gradient(circle, var(--metallic-gold), #8f6b21 70%); opacity: 0.2; }
      .orb-coral { width: 550px; height: 550px; bottom: -150px; left: 25%; background: radial-gradient(circle, var(--sunset-coral), #7d1c08 70%); opacity: 0.16; }

      /* Full Widescreen Layout (matches index width) */
      .content-wrapper {
        position: relative;
        z-index: 1;
        width: 94%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 32px 0 90px;
        animation: pageFadeIn 0.4s ease-out;
      }

      /* Back Navigation Button */
      .back-nav {
        margin-bottom: 24px;
      }

      .back-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 20px;
        background: rgba(27, 77, 62, 0.35);
        border: 1px solid rgba(229, 184, 105, 0.25);
        border-radius: 999px;
        color: var(--cream-light);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.84rem;
        backdrop-filter: blur(12px);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .back-button:hover {
        background: var(--forest-emerald);
        border-color: var(--metallic-gold);
        box-shadow: 0 4px 18px var(--gold-glow);
        transform: translateX(-4px);
        color: #ffffff;
      }

      /* Main Article Glass Container */
      article {
        background: var(--glass-surface);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: clamp(28px, 4vw, 54px);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55), 0 0 25px rgba(229, 184, 105, 0.08);
      }

      /* Headers */
      article h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2.2rem, 3.8vw, 3.2rem);
        font-weight: 700;
        color: var(--cream-light);
        line-height: 1.2;
        margin-bottom: 24px;
        letter-spacing: -0.01em;
      }

      article h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.4rem, 2.2vw, 1.85rem);
        color: var(--cream-light);
        margin: 40px 0 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(229, 184, 105, 0.2);
      }

      article h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
        color: var(--metallic-gold);
        margin: 28px 0 12px;
      }

      article p {
        margin-bottom: 16px;
        color: var(--cream-body);
        font-size: 1.02rem;
      }

      /* Quick Verdict Quote / Callout Block */
      article blockquote {
        background: linear-gradient(135deg, rgba(27, 77, 62, 0.45), rgba(19, 42, 33, 0.6));
        border-left: 4px solid var(--sunset-coral);
        border-radius: 12px;
        margin: 24px 0 32px;
        padding: 20px 26px;
        font-size: 1.1rem;
        color: var(--cream-light);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
      }

      /* Widescreen Comparison Table */
      article table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 32px 0 40px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(229, 184, 105, 0.25);
        background: rgba(14, 20, 17, 0.65);
      }

      article th, article td {
        padding: 16px 22px;
        text-align: left;
      }

      article th {
        background: rgba(27, 77, 62, 0.65);
        color: var(--metallic-gold);
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(229, 184, 105, 0.25);
      }

      article td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        color: var(--cream-body);
        font-size: 0.98rem;
      }

      article tr:last-child td {
        border-bottom: none;
      }

      article tr:hover td {
        background: rgba(229, 184, 105, 0.05);
      }

      /* External & Affiliate Action Links (Sunset Coral) */
      article a {
        color: var(--sunset-coral);
        text-decoration: none;
        font-weight: 700;
        transition: color 0.2s ease, text-shadow 0.2s ease;
      }

      article a:hover {
        color: #ff7e62;
        text-decoration: underline;
        text-shadow: 0 0 10px var(--coral-glow);
      }

      /* Lists & Pros/Cons */
      article ul, article ol {
        padding-left: 24px;
        margin-bottom: 24px;
      }

      article li {
        margin-bottom: 10px;
        color: var(--cream-body);
      }

      article li strong {
        color: var(--cream-light);
      }

      article hr {
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin: 40px 0;
      }

      @keyframes pageFadeIn {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 768px) {
        .content-wrapper { width: 92%; }
        article { padding: 24px 18px; }
        article table { font-size: 0.88rem; }
        article th, article td { padding: 12px 14px; }
      }
    </style>
  </head>
  <body>
    <div class="ambient-glow">
      <div class="glow-orb orb-forest"></div>
      <div class="glow-orb orb-gold"></div>
      <div class="glow-orb orb-coral"></div>
    </div>

    <div class="content-wrapper">
      <nav class="back-nav">
        <a href="/" class="back-button">
          <span>←</span>
          <span>Back to All Comparisons</span>
        </a>
      </nav>

      <article>
        <Content />
      </article>
    </div>
  </body>
</html>
