---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('comparisons');
  return posts.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 1. Fetch related comparisons from the same category
const allComparisons = await getCollection('comparisons');
const currentCategory = entry.data.category || 'Developer Tools';
const currentSlug = entry.data.slug || entry.id.replace(/\.md$/, '');

const relatedComparisons = allComparisons
  .filter((item) => {
    const itemCategory = item.data.category || 'Developer Tools';
    const itemSlug = item.data.slug || item.id.replace(/\.md$/, '');
    return itemCategory === currentCategory && itemSlug !== currentSlug;
  })
  .slice(0, 3);

// 2. Extract tool names safely with clean title formatting
const slugParts = currentSlug.split('-vs-');
const formatToolName = (str: string) =>
  str
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const toolA = entry.data.tool_a || (slugParts[0] ? formatToolName(slugParts[0]) : 'Tool A');
const toolB = entry.data.tool_b || (slugParts[1] ? formatToolName(slugParts[1]) : 'Tool B');

// 3. JSON-LD Structured Data Schemas (Optimized for Google Rich Snippets)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is ${toolA} better than ${toolB}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": entry.data.description
      }
    },
    {
      "@type": "Question",
      "name": `How do ${toolA} and ${toolB} compare in pricing?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${toolA} and ${toolB} have different pricing models depending on team scale and architecture. Check our breakdown table above for exact tier specs.`
      }
    }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `${toolA} vs ${toolB} Comparison`,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Cloud / Platform Independent",
  "description": entry.data.description,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "128",
    "bestRating": "5",
    "worstRating": "1"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} — StackVersus</title>
    <meta name="description" content={entry.data.description} />
    
    <!-- Google Rich Snippet JSON-LD Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --z-black: #060707;
        --z-card: rgba(14, 16, 15, 0.72);
        --z-card-hover: rgba(22, 26, 24, 0.85);
        --z-border: rgba(255, 255, 255, 0.08);
        --z-border-glow: rgba(34, 229, 118, 0.4);
        --z-lime: #22E576;
        --z-lime-glow: rgba(34, 229, 118, 0.35);
        --z-coral: #FF385C;
        --z-gold: #FFC043;
        --z-text: #F2F2F2;
        --z-muted: #8E928E;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--z-black);
        color: var(--z-text);
        min-height: 100vh;
        overflow-x: hidden;
      }

      #zajno-motion-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
      }

      .viewport-wrapper {
        position: relative;
        z-index: 1;
        width: 95%;
        max-width: 1720px;
        margin: 0 auto;
        padding: 28px 0 100px;
      }

      .hud-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--z-border);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
        color: var(--z-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .hud-live {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--z-lime);
      }
      .hud-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--z-lime);
        box-shadow: 0 0 10px var(--z-lime);
        animation: pulse 1.8s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      .subnav {
        margin: 32px 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #ffffff;
        text-decoration: none;
        padding: 8px 20px;
        border-radius: 999px;
        background: rgba(14, 18, 16, 0.8);
        border: 1px solid var(--z-border);
        backdrop-filter: blur(16px);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .back-btn:hover {
        background: var(--z-lime);
        color: #000000;
        border-color: var(--z-lime);
        box-shadow: 0 0 18px var(--z-lime-glow);
        transform: translateX(-4px);
      }

      .spec-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--z-lime);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .editorial-workspace {
        background: var(--z-card);
        border: 1px solid var(--z-border);
        border-radius: 22px;
        padding: clamp(32px, 4vw, 64px);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
      }

      .editorial-workspace h1 {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2.4rem, 4.8vw, 4.4rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.04em;
        text-transform: uppercase;
        color: #ffffff;
        margin-bottom: 24px;
      }

      .editorial-workspace h1 .kinetic-accent {
        background: linear-gradient(90deg, #FFFFFF 10%, var(--z-lime) 50%, var(--z-coral) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .editorial-workspace h2 {
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.4rem, 2.2vw, 1.9rem);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin: 44px 0 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--z-border);
      }

      .editorial-workspace h3 {
        font-family: 'Syne', sans-serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--z-lime);
        margin: 32px 0 12px;
      }

      .editorial-workspace p {
        font-size: 1.04rem;
        color: var(--z-text);
        line-height: 1.7;
        margin-bottom: 18px;
      }

      .editorial-workspace blockquote {
        background: linear-gradient(135deg, rgba(34, 229, 118, 0.1), rgba(14, 18, 16, 0.8));
        border-left: 4px solid var(--z-lime);
        border-radius: 12px;
        margin: 28px 0 38px;
        padding: 24px 30px;
        font-size: 1.15rem;
        color: #ffffff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      }

      .editorial-workspace table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin: 32px 0 44px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--z-border);
        background: rgba(10, 12, 11, 0.7);
      }

      .editorial-workspace th, .editorial-workspace td {
        padding: 18px 24px;
        text-align: left;
        vertical-align: top;
      }

      .editorial-workspace th {
        background: rgba(255, 255, 255, 0.04);
        color: var(--z-lime);
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--z-border);
      }

      .editorial-workspace td {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        font-size: 0.96rem;
      }

      .editorial-workspace tr:last-child td { border-bottom: none; }
      .editorial-workspace tr:hover td { background: rgba(34, 229, 118, 0.03); }

      .editorial-workspace a {
        color: var(--z-coral);
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .editorial-workspace a:hover {
        color: #ff607f;
        text-decoration: underline;
      }

      .comparison-matrix {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin: 32px 0 44px;
      }

      .matrix-card {
        background: rgba(18, 22, 20, 0.7);
        border: 1px solid var(--z-border);
        border-radius: 16px;
        padding: 26px;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }
      .matrix-card:hover {
        border-color: var(--z-border-glow);
        transform: translateY(-4px);
      }

      .matrix-title {
        font-family: 'Syne', sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 6px;
      }

      .matrix-tagline {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
        color: var(--z-muted);
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--z-border);
      }

      .matrix-section-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 16px 0 10px;
      }
      .matrix-section-title.pros { color: var(--z-lime); }
      .matrix-section-title.cons { color: var(--z-coral); }

      .matrix-list {
        list-style: none !important;
        padding-left: 0 !important;
        margin-bottom: 16px !important;
      }

      .matrix-list li {
        position: relative;
        padding-left: 24px;
        margin-bottom: 10px;
        font-size: 0.94rem;
        color: var(--z-text);
      }

      .matrix-list.pros li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--z-lime);
        font-weight: 800;
      }

      .matrix-list.cons li::before {
        content: "✕";
        position: absolute;
        left: 0;
        color: var(--z-coral);
        font-weight: 800;
      }

      /* Related comparisons hover transition */
      .related-card {
        display: block;
        padding: 1.1rem;
        border-radius: 12px;
        background: var(--z-card);
        border: 1px solid var(--z-border);
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .related-card:hover {
        border-color: var(--z-lime);
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(34, 229, 118, 0.15);
      }

      @media (max-width: 850px) {
        .comparison-matrix { grid-template-columns: 1fr; }
        .viewport-wrapper { width: 92%; }
        .editorial-workspace { padding: 24px 18px; }
      }
    </style>
  </head>
  <body>
    <canvas id="zajno-motion-canvas"></canvas>

    <div class="viewport-wrapper">
      <div class="hud-topbar">
        <div class="hud-live">
          <span class="hud-dot"></span>
          StackVersus // Kinetic System 2.0
        </div>
        <div>Engine: StackVersus Matrix</div>
        <div>State: 60 FPS Accelerated</div>
      </div>

      <nav class="subnav">
        <a href="/" class="back-btn">
          <span>←</span>
          <span>Back to All Comparisons</span>
        </a>
        <div class="spec-tag">
          // HEAD-TO-HEAD MATRIX: {toolA} VS {toolB}
        </div>
      </nav>

      <main class="editorial-workspace" id="markdown-content">
        <Content />

        {relatedComparisons.length > 0 && (
          <section style="margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid var(--z-border);">
            <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--z-text); margin-bottom: 1.25rem; font-family: 'Syne', sans-serif;">
              Related {currentCategory} Comparisons
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
              {relatedComparisons.map((item) => {
                const itemSlug = item.data.slug || item.id.replace(/\.md$/, '');
                const rParts = itemSlug.split('-vs-');
                const targetA = item.data.tool_a || (rParts[0] ? formatToolName(rParts[0]) : 'Tool A');
                const targetB = item.data.tool_b || (rParts[1] ? formatToolName(rParts[1]) : 'Tool B');
                return (
                  <a href={`/comparisons/${itemSlug}`} class="related-card">
                    <span style="font-weight: 700; color: #ffffff; display: block; font-size: 1rem; margin-bottom: 0.35rem;">
                      {targetA} vs {targetB}
                    </span>
                    <span style="font-size: 0.8rem; color: var(--z-lime); font-family: 'JetBrains Mono', monospace; display: block;">
                      Read Deep-Dive →
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        )}
      </main>
    </div>

    <!-- Client-Side Transformer: Matrix Layout + Kinetic Ribbon Engine -->
    <script>
      const canvas = document.getElementById('zajno-motion-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      let time = 0;
      function renderRibbon() {
        ctx.fillStyle = '#060707';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        time += 0.016;

        const normY = mouseY / canvas.height;

        const ribbons = [
          { color: '#22E576', alpha: 0.35, width: 2.5, speed: 1.0, freq: 0.002, amp: 90 },
          { color: '#FF385C', alpha: 0.28, width: 2.0, speed: 1.3, freq: 0.0025, amp: 120 },
        ];

        ribbons.forEach((ribbon, i) => {
          ctx.beginPath();
          ctx.strokeStyle = ribbon.color;
          ctx.lineWidth = ribbon.width;
          ctx.globalAlpha = ribbon.alpha;

          for (let x = 0; x < canvas.width; x += 8) {
            const dynamicAmp = ribbon.amp * (0.8 + normY * 0.6);
            const y = (canvas.height * 0.5) + 
                      Math.sin(x * ribbon.freq + time * ribbon.speed + i) * dynamicAmp * Math.cos(time * 0.4 + i);

            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        });

        requestAnimationFrame(renderRibbon);
      }
      renderRibbon();

      // Tabular Pros & Cons Transformer
      const contentRoot = document.getElementById('markdown-content');
      if (contentRoot) {
        const h1 = contentRoot.querySelector('h1');
        if (h1 && !h1.querySelector('.kinetic-accent')) {
          const text = h1.textContent || '';
          if (text.includes(':')) {
            const [first, rest] = text.split(':');
            h1.innerHTML = `${first}: <span class="kinetic-accent">${rest}</span>`;
          }
        }

        const h3s = Array.from(contentRoot.querySelectorAll('h3'));
        if (h3s.length >= 2) {
          const matrixContainer = document.createElement('div');
          matrixContainer.className = 'comparison-matrix';

          h3s.slice(0, 2).forEach(h3 => {
            const card = document.createElement('div');
            card.className = 'matrix-card';

            const title = document.createElement('div');
            title.className = 'matrix-title';
            title.textContent = h3.textContent;
            card.appendChild(title);

            let next = h3.nextElementSibling;
            while (next && next.tagName !== 'H3' && next.tagName !== 'H2') {
              const current = next;
              next = current.nextElementSibling;

              if (current.tagName === 'P' && current.querySelector('em')) {
                current.className = 'matrix-tagline';
                card.appendChild(current);
              } else if (current.tagName === 'P' && current.textContent?.includes('Pros:')) {
                const prosTitle = document.createElement('div');
                prosTitle.className = 'matrix-section-title pros';
                prosTitle.textContent = 'Pros';
                card.appendChild(prosTitle);
                current.remove();
              } else if (current.tagName === 'P' && current.textContent?.includes('Cons:')) {
                const consTitle = document.createElement('div');
                consTitle.className = 'matrix-section-title cons';
                consTitle.textContent = 'Cons';
                card.appendChild(consTitle);
                current.remove();
              } else if (current.tagName === 'UL') {
                const prev = card.lastElementChild;
                if (prev?.classList.contains('cons')) {
                  current.className = 'matrix-list cons';
                } else {
                  current.className = 'matrix-list pros';
                }
                card.appendChild(current);
              }
            }

            h3.remove();
            matrixContainer.appendChild(card);
          });

          const detailedH2 = Array.from(contentRoot.querySelectorAll('h2')).find(h => h.textContent?.includes('Detailed Breakdown'));
          if (detailedH2) {
            detailedH2.insertAdjacentElement('afterend', matrixContainer);
          } else {
            contentRoot.appendChild(matrixContainer);
          }
        }
      }
    </script>
  </body>
</html>