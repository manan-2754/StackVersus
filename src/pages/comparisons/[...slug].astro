---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HudBar from '../../components/HudBar.astro';
import Footer from '../../components/Footer.astro';
import RibbonCanvas from '../../components/RibbonCanvas.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('comparisons');
  return posts.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

function formatToolName(str: string) {
  return str
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

function slugify(text: string) {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

function parseFAQ(body: string) {
  const faqs: { question: string; answer: string }[] = [];
  const sectionMatch = body.match(/##\s*Frequently Asked Questions[\s\S]*$/i);
  if (!sectionMatch) return faqs;
  const section = sectionMatch[0];
  const questionRegex = /^###\s*(.+)[\r\n]+([\s\S]*?)(?=^###|\z)/gm;
  let match;
  while ((match = questionRegex.exec(section)) !== null) {
    const question = match[1].trim();
    const answer = match[2].trim().replace(/\n/g, ' ');
    if (question && answer) faqs.push({ question, answer });
  }
  return faqs;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siteUrl = 'https://stackversus.pages.dev';
const currentSlug = entry.data.slug || entry.id.replace(/\.md$/, '');
const pageUrl = `${siteUrl}/comparisons/${currentSlug}/`;
const currentCategory = entry.data.category || 'Developer Tools';
const categorySlug = slugify(currentCategory);

const allComparisons = await getCollection('comparisons');
const relatedComparisons = allComparisons
  .filter(
    (item) =>
      (item.data.category || 'Developer Tools') === currentCategory &&
      (item.data.slug || item.id.replace(/\.md$/, '')) !== currentSlug
  )
  .slice(0, 4);

const slugParts = currentSlug.split('-vs-');
const toolA = entry.data.tool_a || (slugParts[0] ? formatToolName(slugParts[0]) : 'Tool A');
const toolB = entry.data.tool_b || (slugParts[1] ? formatToolName(slugParts[1]) : 'Tool B');

let datePublished = '';
let dateModified = '';
if (entry.data.date || entry.data.lastmod) {
  datePublished = new Date(entry.data.date || entry.data.lastmod || Date.now()).toISOString();
  dateModified = new Date(entry.data.lastmod || entry.data.date || Date.now()).toISOString();
} else {
  try {
    const stats = fs.statSync(path.resolve(entry.filePath || ''));
    datePublished = stats.birthtime.toISOString();
    dateModified = stats.mtime.toISOString();
  } catch {
    const now = new Date().toISOString();
    datePublished = now;
    dateModified = now;
  }
}

const wordCount = (entry.body || '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const formattedDate = new Date(dateModified).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const tocHeadings = (entry.body || '')
  .split('\n')
  .filter((line) => line.startsWith('## '))
  .map((line) => ({ title: line.replace(/^##\s*/, '').trim(), slug: slugify(line.replace(/^##\s*/, '')) }))
  .filter((h) => h.title && h.slug && h.title !== 'Frequently Asked Questions');

const metrics = {
  performance: entry.data.metrics?.performance ?? 0,
  ecosystem: entry.data.metrics?.ecosystem ?? 0,
  learning_curve: entry.data.metrics?.learning_curve ?? 0,
  community: entry.data.metrics?.community ?? 0,
};
const hasMetrics = Object.values(metrics).some((v) => v > 0);
const useCases = entry.data.use_cases || [];
const difficulty = entry.data.difficulty || 'Intermediate';
const popularity = entry.data.popularity ?? 50;
const verdict = entry.data.verdict || '';
const faqs = parseFAQ(entry.body || '');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: currentCategory, item: `${siteUrl}/categories/${categorySlug}/` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  url: pageUrl,
  datePublished,
  dateModified,
  author: { '@type': 'Organization', name: 'StackVersus', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'StackVersus', url: siteUrl },
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${toolA} vs ${toolB} Comparison`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cloud / Platform Independent',
  description: entry.data.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.length
    ? faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      }))
    : [
        {
          '@type': 'Question',
          name: `Is ${toolA} better than ${toolB}?`,
          acceptedAnswer: { '@type': 'Answer', text: entry.data.description },
        },
        {
          '@type': 'Question',
          name: `How do ${toolA} and ${toolB} compare in pricing?`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `${toolA} and ${toolB} have different pricing models depending on team scale and architecture.`,
          },
        },
      ],
};

const schema = [breadcrumbSchema, articleSchema, productSchema, faqSchema];

function toolSlug(name: string) {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
---

<BaseLayout
  title={`${entry.data.title} — StackVersus`}
  description={entry.data.description}
  canonical={pageUrl}
  ogType="article"
  ogTitle={entry.data.title}
  ogDescription={entry.data.description}
  ogImage={`${siteUrl}/og/comparisons/${currentSlug}.png`}
  schema={schema}
>
  <RibbonCanvas />

  <div class="viewport-wrapper comparison-wrapper">
    <HudBar left={`Comparisons // ${currentCategory}`} center="Engine: StackVersus Matrix" right="State: Live" />

    <nav class="subnav" aria-label="Breadcrumb">
      <a href="/" class="back-btn">← Back to Explore</a>
      <a href={`/categories/${categorySlug}/`} class="category-chip">{currentCategory}</a>
    </nav>

    <header class="comparison-hero motion-fade-up">
      <div class="hero-tools">
        <a href={`/tools/${toolSlug(toolA)}/`} class="tool-pill primary">{toolA}</a>
        <span class="vs-badge">VS</span>
        <a href={`/tools/${toolSlug(toolB)}/`} class="tool-pill accent">{toolB}</a>
      </div>
      <h1>{entry.data.title}</h1>
      {
        verdict && (
          <div class="verdict-banner" role="note">
            <span class="verdict-label">Verdict</span>
            <span class="verdict-text">{verdict}</span>
          </div>
        )
      }
      <p class="hero-description">{entry.data.description}</p>
      {
        entry.data.source === 'catalog' && (
          <p class="catalog-note" role="note">
            Built from the StackVersus tool catalog: structured pricing models, licensing, hosting and editor-curated
            pros and cons. Last reviewed {formattedDate}. Spotted something out of date?{' '}
            <a href={`/contact/?page=${encodeURIComponent(pageUrl)}`}>Send a correction</a>.
          </p>
        )
      }
      <div class="meta-bar">
        <span class="meta-pill">Updated {formattedDate}</span>
        <span class="meta-pill">{readingTime} min read</span>
        <span class="meta-pill">{wordCount.toLocaleString()} words</span>
        <span class="meta-pill difficulty">{difficulty}</span>
        <span class="meta-pill popularity">Popularity {popularity}/100</span>
      </div>
    </header>

    {
      hasMetrics && (
        <section class="metrics-panel motion-fade-up" aria-label="Scorecard">
          <h2 class="sr-only">Comparison Scorecard</h2>
          <div class="metric">
            <span class="metric-label">Performance</span>
            <div class="metric-track">
              <div class="metric-fill" style={`width: ${metrics.performance}%`} />
            </div>
            <span class="metric-value">{metrics.performance}</span>
          </div>
          <div class="metric">
            <span class="metric-label">Ecosystem</span>
            <div class="metric-track">
              <div class="metric-fill" style={`width: ${metrics.ecosystem}%`} />
            </div>
            <span class="metric-value">{metrics.ecosystem}</span>
          </div>
          <div class="metric">
            <span class="metric-label">Learning Curve</span>
            <div class="metric-track">
              <div class="metric-fill" style={`width: ${metrics.learning_curve}%`} />
            </div>
            <span class="metric-value">{metrics.learning_curve}</span>
          </div>
          <div class="metric">
            <span class="metric-label">Community</span>
            <div class="metric-track">
              <div class="metric-fill" style={`width: ${metrics.community}%`} />
            </div>
            <span class="metric-value">{metrics.community}</span>
          </div>
        </section>
      )
    }

    {
      useCases.length > 0 && (
        <section class="use-cases motion-fade-up" aria-label="Best use cases">
          {useCases.map((use) => (
            <span class="use-case-chip">{use}</span>
          ))}
        </section>
      )
    }

    <div class="tabs motion-fade-up" role="tablist" aria-label="Comparison sections">
      <button class="tab active" data-tab="overview" role="tab" aria-selected="true">Overview</button>
      <button class="tab" data-tab="specs" role="tab" aria-selected="false">Specs</button>
      <button class="tab" data-tab="faq" role="tab" aria-selected="false">FAQ</button>
      <button class="tab" data-tab="community" role="tab" aria-selected="false">Community</button>
    </div>

    <main class="editorial-workspace" id="main-content">
      <section class="tab-panel active" data-panel="overview" role="tabpanel">
        {
          tocHeadings.length > 0 && (
            <nav class="toc" aria-label="Table of contents">
              <h2 class="toc-title">On this page</h2>
              <ol class="toc-list">
                {tocHeadings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.title}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="article-content">
          <Content />
        </div>
      </section>

      <section class="tab-panel" data-panel="specs" role="tabpanel">
        <h2 class="panel-title">Specification Matrix</h2>
        <div class="comparison-matrix" id="comparison-matrix">
          <p class="panel-hint">The matrix is generated from the pros/cons in the article.</p>
        </div>
        {
          entry.data.pricing && (
            <div class="pricing-card">
              <h3>Pricing Snapshot</h3>
              <dl>
                {entry.data.pricing.model && (
                  <div class="pricing-row">
                    <dt>Model</dt>
                    <dd>{entry.data.pricing.model}</dd>
                  </div>
                )}
                {entry.data.pricing.starting_price && (
                  <div class="pricing-row">
                    <dt>Starts at</dt>
                    <dd>{entry.data.pricing.starting_price}</dd>
                  </div>
                )}
                <div class="pricing-row">
                  <dt>Free tier</dt>
                  <dd>{entry.data.pricing.free_tier ? 'Yes' : 'No / N/A'}</dd>
                </div>
              </dl>
            </div>
          )
        }
      </section>

      <section class="tab-panel" data-panel="faq" role="tabpanel">
        <h2 class="panel-title">Frequently Asked Questions</h2>
        {
          faqs.length > 0 ? (
            <div class="faq-list">
              {faqs.map((f) => (
                <details class="faq-item">
                  <summary>{f.question}</summary>
                  <p>{f.answer}</p>
                </details>
              ))}
            </div>
          ) : (
            <p class="panel-hint">No FAQ extracted for this comparison.</p>
          )
        }
      </section>

      <section class="tab-panel" data-panel="community" role="tabpanel">
        <div class="community-grid">
          <div>
            <h2 class="panel-title">Share & Discuss</h2>
            <ShareButtons title={entry.data.title} url={pageUrl} />
          </div>
          {
            relatedComparisons.length > 0 && (
              <div>
                <h2 class="panel-title">Related in {currentCategory}</h2>
                <div class="related-list">
                  {relatedComparisons.map((item) => {
                    const itemSlug = item.data.slug || item.id.replace(/\.md$/, '');
                    return (
                      <a href={`/comparisons/${itemSlug}/`} class="related-card">
                        {item.data.title}
                      </a>
                    );
                  })}
                </div>
              </div>
            )
          }
        </div>
        <Comments pageId={currentSlug} />
      </section>
    </main>

    <p class="affiliate-disclosure" role="note">
      <strong>Disclosure:</strong> Outbound links go to official product sites. If we have an affiliate partnership, the link
      will be marked as such. Read the{' '}
      <a href="/about#disclosure">full disclosure</a>.
    </p>

    <Footer />
  </div>

  <script>
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const key = btn.getAttribute('data-tab');
        document.querySelector<HTMLElement>(`[data-panel="${key}"]`)?.classList.add('active');
      });
    });

    // Build comparison matrix from H3 pros/cons blocks inside the rendered article
    const contentRoot = document.querySelector('.article-content');
    const matrixContainer = document.getElementById('comparison-matrix');
    if (contentRoot && matrixContainer) {
      const h3s = Array.from(contentRoot.querySelectorAll('h3'));
      if (h3s.length >= 2) {
        const matrix = document.createElement('div');
        matrix.className = 'matrix-grid';
        h3s.slice(0, 2).forEach((h3) => {
          const card = document.createElement('div');
          card.className = 'matrix-card';
          const title = document.createElement('div');
          title.className = 'matrix-title';
          title.textContent = h3.textContent;
          card.appendChild(title);
          let next = h3.nextElementSibling;
          while (next && next.tagName !== 'H3' && next.tagName !== 'H2') {
            const current = next;
            next = current.nextElementSibling;
            if (current.tagName === 'P' && current.querySelector('em')) {
              current.className = 'matrix-tagline';
              card.appendChild(current);
            } else if (current.tagName === 'P' && current.textContent?.includes('Pros:')) {
              const t = document.createElement('div');
              t.className = 'matrix-section-title pros';
              t.textContent = 'Pros';
              card.appendChild(t);
              current.remove();
            } else if (current.tagName === 'P' && current.textContent?.includes('Cons:')) {
              const t = document.createElement('div');
              t.className = 'matrix-section-title cons';
              t.textContent = 'Cons';
              card.appendChild(t);
              current.remove();
            } else if (current.tagName === 'UL') {
              const prev = card.lastElementChild;
              current.className = `matrix-list ${prev?.classList.contains('cons') ? 'cons' : 'pros'}`;
              card.appendChild(current);
            }
          }
          h3.remove();
          matrix.appendChild(card);
        });
        matrixContainer.innerHTML = '';
        matrixContainer.appendChild(matrix);
      }
    }

    // Page feedback widget
    const feedbackKey = `feedback-${window.location.pathname}`;
    const feedbackThanks = document.getElementById('feedback-thanks');
    const feedbackButtons = document.querySelectorAll<HTMLButtonElement>('.feedback-btn');
    const existingFeedback = localStorage.getItem(feedbackKey);
    if (existingFeedback && feedbackThanks) {
      feedbackThanks.style.display = 'block';
      feedbackButtons.forEach((b) => (b.disabled = true));
    }
    feedbackButtons.forEach((button) => {
      button.addEventListener('click', () => {
        localStorage.setItem(feedbackKey, button.getAttribute('data-value') || '');
        feedbackButtons.forEach((b) => (b.disabled = true));
        if (feedbackThanks) feedbackThanks.style.display = 'block';
      });
    });
  </script>

  <style is:global>
    .comparison-hero {
      margin: 28px 0 32px;
      padding: clamp(32px, 5vw, 56px);
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-radius: 24px;
      box-shadow: 0 24px 60px rgba(5, 3, 12, 0.08);
    }

    .hero-tools {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .tool-pill {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }
    .tool-pill:hover,
    .tool-pill:focus-visible {
      transform: translateY(-2px);
      outline: none;
    }
    .tool-pill.primary {
      background: var(--z-primary);
      color: #ffffff;
      box-shadow: 0 0 20px var(--z-primary-glow);
    }
    .tool-pill.accent {
      background: var(--z-accent);
      color: #ffffff;
    }

    .vs-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--z-muted);
    }

    .comparison-hero h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(1.8rem, 4vw, 3.2rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--z-text);
      margin-bottom: 16px;
    }

    .verdict-banner {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(106, 75, 205, 0.08), rgba(214, 107, 178, 0.08));
      border: 1px solid rgba(106, 75, 205, 0.2);
      margin-bottom: 18px;
    }
    .verdict-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--z-primary);
    }
    .verdict-text {
      font-weight: 600;
      color: var(--z-text);
      font-size: 0.95rem;
    }

    .hero-description {
      color: var(--z-muted);
      font-size: 1.05rem;
      max-width: 720px;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .catalog-note {
      font-size: 0.82rem;
      color: var(--z-muted);
      line-height: 1.55;
      max-width: 720px;
      margin: -6px 0 20px;
      padding: 10px 14px;
      border-left: 3px solid var(--z-primary);
      background: rgba(106, 75, 205, 0.05);
      border-radius: 0 10px 10px 0;
    }
    .catalog-note a {
      color: var(--z-primary);
      font-weight: 600;
    }

    .meta-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .meta-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--z-muted);
      background: rgba(5, 3, 12, 0.04);
      border: 1px solid var(--z-border);
      border-radius: 999px;
      padding: 5px 12px;
    }
    .meta-pill.difficulty {
      color: var(--z-accent);
      background: rgba(214, 107, 178, 0.08);
    }
    .meta-pill.popularity {
      color: var(--z-primary);
      background: rgba(106, 75, 205, 0.08);
    }

    .metrics-panel {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-bottom: 24px;
      padding: 24px;
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-radius: 18px;
    }
    .metric {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .metric-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      text-transform: uppercase;
      color: var(--z-muted);
    }
    .metric-track {
      height: 8px;
      background: var(--z-border);
      border-radius: 999px;
      overflow: hidden;
    }
    .metric-fill {
      height: 100%;
      background: var(--z-gradient);
      border-radius: 999px;
      transition: width 1s ease;
    }
    .metric-value {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--z-text);
    }

    .use-cases {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 24px;
    }
    .use-case-chip {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--z-primary);
      background: rgba(106, 75, 205, 0.08);
      border: 1px solid rgba(106, 75, 205, 0.2);
      border-radius: 999px;
      padding: 6px 14px;
    }

    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 0;
      padding: 6px;
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-bottom: none;
      border-radius: 18px 18px 0 0;
      width: fit-content;
    }
    .tab {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 8px 18px;
      border-radius: 12px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--z-muted);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .tab:hover,
    .tab:focus-visible {
      color: var(--z-text);
      background: rgba(5, 3, 12, 0.04);
      outline: none;
    }
    .tab.active {
      background: #ffffff;
      color: var(--z-primary);
      border-color: var(--z-border);
      box-shadow: 0 4px 12px rgba(5, 3, 12, 0.05);
    }

    .editorial-workspace {
      background: var(--z-surface);
      border: 1px solid var(--z-border);
      border-radius: 0 24px 24px 24px;
      padding: clamp(32px, 4vw, 64px);
      backdrop-filter: blur(24px);
      box-shadow: 0 25px 60px rgba(5, 3, 12, 0.08);
    }

    .tab-panel {
      display: none;
      animation: fade-in 0.3s ease;
    }
    .tab-panel.active {
      display: block;
    }

    .panel-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 700;
