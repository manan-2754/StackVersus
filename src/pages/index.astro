---
import { getCollection } from 'astro:content';

const rawComparisons = await getCollection('comparisons');

function mapToCluster(cat: string = ''): string {
  const c = cat.toLowerCase();
  if (c.includes('ai') || c.includes('writing') || c.includes('copilot') || c.includes('cursor')) return 'AI & Agents';
  if (c.includes('database') || c.includes('api') || c.includes('orm') || c.includes('caching') || c.includes('backend')) return 'Data & APIs';
  if (c.includes('task') || c.includes('project') || c.includes('sprint') || c.includes('workspace') || c.includes('productivity') || c.includes('knowledge') || c.includes('messaging') || c.includes('newsletter') || c.includes('publishing')) return 'Workflows';
  if (c.includes('design') || c.includes('css') || c.includes('web') || c.includes('frontend')) return 'Creative & UI';
  if (c.includes('observability') || c.includes('monitoring') || c.includes('security') || c.includes('container') || c.includes('devops')) return 'Infra & Sec';
  return 'Cloud & Growth';
}

const comparisons = rawComparisons.map(item => ({
  ...item,
  cluster: mapToCluster(item.data.category),
}));

const clusters = ['All', 'AI & Agents', 'Data & APIs', 'Workflows', 'Creative & UI', 'Infra & Sec', 'Cloud & Growth'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="rtsDytRNMUXcqZtXlPZqarvwSa3aukoYtoX-if1ThTc" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StackVersus — Kinetic Benchmark Engine [Zajno Motion]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --z-black: #060707;
        --z-card: rgba(14, 16, 15, 0.72);
        --z-card-hover: rgba(22, 26, 24, 0.85);
        --z-border: rgba(255, 255, 255, 0.08);
        --z-border-glow: rgba(34, 229, 118, 0.4);
        --z-lime: #22E576;
        --z-lime-glow: rgba(34, 229, 118, 0.35);
        --z-coral: #FF385C;
        --z-gold: #FFC043;
        --z-text: #F2F2F2;
        --z-muted: #8E928E;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--z-black);
        color: var(--z-text);
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* Fullscreen Interactive WebGL/Canvas Wave Ribbon */
      #zajno-motion-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
      }

      /* Screen Space Widescreen Layout */
      .viewport-wrapper {
        position: relative;
        z-index: 1;
        width: 95%;
        max-width: 1720px;
        margin: 0 auto;
        padding: 28px 0 100px;
      }

      /* Top HUD Bar */
      .hud-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--z-border);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
        color: var(--z-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .hud-live {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--z-lime);
      }
      .hud-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--z-lime);
        box-shadow: 0 0 10px var(--z-lime);
        animation: pulse 1.8s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      /* Zajno Kinetic Hero Header */
      header {
        margin: 40px 0 36px;
      }

      .hero-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--z-lime);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 12px;
        display: inline-block;
      }

      h1 {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2.4rem, 5.2vw, 4.8rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.04em;
        text-transform: uppercase;
        color: #ffffff;
      }

      h1 span.kinetic-gradient {
        background: linear-gradient(90deg, #FFFFFF 10%, var(--z-lime) 50%, var(--z-coral) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      header p {
        font-size: 1.05rem;
        color: var(--z-muted);
        max-width: 620px;
        margin-top: 14px;
        line-height: 1.6;
      }

      /* Single-Line Kinetic Pill Nav Bar */
      .nav-container {
        display: flex;
        align-items: center;
        margin-bottom: 34px;
        width: 100%;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .nav-container::-webkit-scrollbar { display: none; }

      .filter-bar {
        display: inline-flex;
        flex-wrap: nowrap;
        gap: 8px;
        padding: 6px;
        background: rgba(14, 18, 16, 0.7);
        border: 1px solid var(--z-border);
        border-radius: 999px;
        backdrop-filter: blur(20px);
      }

      .filter-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 7px 18px;
        border-radius: 999px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--z-muted);
        cursor: pointer;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
      }

      .filter-pill:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.05);
      }

      .filter-pill.active {
        background: var(--z-lime);
        color: #000000;
        font-weight: 700;
        border-color: var(--z-lime);
        box-shadow: 0 0 16px var(--z-lime-glow);
      }

      /* Expansive Card Grid */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 24px;
      }

      /* Zajno Style Kinetic Glass Card */
      .card {
        position: relative;
        background: var(--z-card);
        border: 1px solid var(--z-border);
        border-radius: 18px;
        padding: 28px;
        text-decoration: none;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                    border-color 0.35s ease, 
                    box-shadow 0.35s ease;
      }

      /* Hover Glowing Accent Strip */
      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--z-lime), transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .card:hover {
        background: var(--z-card-hover);
        transform: translateY(-6px);
        border-color: var(--z-border-glow);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7), 0 0 25px rgba(34, 229, 118, 0.15);
      }

      .card:hover::before { opacity: 1; }

      .card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .card-category {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--z-lime);
        background: rgba(34, 229, 118, 0.1);
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid rgba(34, 229, 118, 0.25);
      }

      .card-idx {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--z-muted);
      }

      .card h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin-bottom: 12px;
      }

      .card p {
        font-size: 0.92rem;
        color: var(--z-muted);
        line-height: 1.6;
        margin-bottom: 24px;
        flex-grow: 1;
      }

      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }

      .action-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--z-coral);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: gap 0.2s ease, transform 0.2s ease;
      }

      .card:hover .action-pill {
        gap: 10px;
        transform: translateX(4px);
        color: #ff5e7e;
      }

      @media (max-width: 768px) {
        .viewport-wrapper { width: 92%; }
        .grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <!-- Motion Zajno Interactive Kinetic Vector Ribbon Canvas -->
    <canvas id="zajno-motion-canvas"></canvas>

    <div class="viewport-wrapper">
      <div class="hud-topbar">
        <div class="hud-live">
          <span class="hud-dot"></span>
          StackVersus // Kinetic System 2.0
        </div>
        <div>Engine: StackVersus </div>
        <div>State: 60 FPS Accelerated</div>
      </div>

      <header>
        <span class="hero-tag">// Unbiased Software Intelligence</span>
        <h1>
          Compare Top Tools.<br/>
          <span class="kinetic-gradient">Decide In High Motion.</span>
        </h1>
        <p>Real-time architectural benchmarks, deep telemetry specs, and pricing audits to scale modern engineering stacks.</p>
      </header>

      <!-- Single-Line Filter Nav -->
      <div class="nav-container">
        <nav class="filter-bar" aria-label="Category Navigation">
          {clusters.map((cluster, i) => (
            <button class={`filter-pill ${i === 0 ? 'active' : ''}`} data-cluster={cluster}>
              {cluster}
            </button>
          ))}
        </nav>
      </div>

      <!-- Expansive Comparison Matrix Grid -->
      <main class="grid" id="comparisons-grid">
        {comparisons.map((item, index) => (
          <a 
            href={`/comparisons/${item.id.replace(/\.md$/, '')}`} 
            class="card"
            data-cluster={item.cluster}
          >
            <div>
              <div class="card-meta">
                <span class="card-category">{item.data.category || 'Benchmark'}</span>
                <span class="card-idx">[0{index + 1}]</span>
              </div>
              <h2>{item.data.title}</h2>
              <p>{item.data.description}</p>
            </div>
            <div class="card-footer">
              <span class="action-pill">Launch Specs <span>→</span></span>
            </div>
          </a>
        ))}
      </main>
    </div>

    <!-- Client-Side Kinetic Canvas Ribbon (Zajno Mathematical Simulation) -->
    <script>
      const canvas = document.getElementById('zajno-motion-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      let time = 0;

      function renderZajnoRibbon() {
        ctx.fillStyle = '#060707';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        time += 0.016;

        const normX = mouseX / canvas.width;
        const normY = mouseY / canvas.height;

        // Draw Ambient Displacement Mesh (Subtle Grid)
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.025)';
        ctx.lineWidth = 1;
        const step = 60;
        for (let x = 0; x < canvas.width; x += step) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, canvas.height);
          ctx.stroke();
        }

        // Draw Multi-Layered Kinetic Bézier Wave Ribbons
        const ribbons = [
          { color: '#22E576', alpha: 0.35, width: 2.5, speed: 1.0, freq: 0.002, amp: 90 },
          { color: '#FF385C', alpha: 0.28, width: 2.0, speed: 1.3, freq: 0.0025, amp: 120 },
          { color: '#FFC043', alpha: 0.20, width: 1.5, speed: 0.8, freq: 0.0018, amp: 70 },
        ];

        ribbons.forEach((ribbon, i) => {
          ctx.beginPath();
          ctx.strokeStyle = ribbon.color;
          ctx.lineWidth = ribbon.width;
          ctx.globalAlpha = ribbon.alpha;

          for (let x = 0; x < canvas.width; x += 8) {
            const dynamicAmp = ribbon.amp * (0.8 + normY * 0.6);
            const y = (canvas.height * 0.5) + 
                      Math.sin(x * ribbon.freq + time * ribbon.speed + i) * dynamicAmp * Math.cos(time * 0.4 + i);

            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        });

        // Interactive Cursor Radial Flare
        const flare = ctx.createRadialGradient(mouseX, mouseY, 10, mouseX, mouseY, 350);
        flare.addColorStop(0, 'rgba(34, 229, 118, 0.08)');
        flare.addColorStop(1, 'transparent');
        ctx.fillStyle = flare;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.globalAlpha = 1.0;
        requestAnimationFrame(renderZajnoRibbon);
      }
      renderZajnoRibbon();

      // Navigation filter
      const buttons = document.querySelectorAll('.filter-pill');
      const cards = document.querySelectorAll<HTMLElement>('.card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const cluster = btn.getAttribute('data-cluster');
          cards.forEach(card => {
            const cardCluster = card.getAttribute('data-cluster');
            if (cluster === 'All' || cardCluster === cluster) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    </script>
  </body>
</html>
