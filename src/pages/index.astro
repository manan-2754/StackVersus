---
import { getCollection } from 'astro:content';

const rawComparisons = await getCollection('comparisons');

function mapToCluster(cat: string = ''): string {
  const c = cat.toLowerCase();
  if (c.includes('ai') || c.includes('writing') || c.includes('copilot') || c.includes('cursor')) return 'AI & Agents';
  if (c.includes('database') || c.includes('api') || c.includes('orm') || c.includes('caching') || c.includes('backend')) return 'Data & APIs';
  if (c.includes('task') || c.includes('project') || c.includes('sprint') || c.includes('workspace') || c.includes('productivity') || c.includes('knowledge') || c.includes('messaging') || c.includes('newsletter') || c.includes('publishing')) return 'Workflows';
  if (c.includes('design') || c.includes('css') || c.includes('web') || c.includes('frontend')) return 'Creative & UI';
  if (c.includes('observability') || c.includes('monitoring') || c.includes('security') || c.includes('container') || c.includes('devops')) return 'Infra & Sec';
  return 'Cloud & Growth';
}

const comparisons = rawComparisons.map(item => ({
  ...item,
  cluster: mapToCluster(item.data.category),
}));

const clusters = ['All', 'AI & Agents', 'Data & APIs', 'Workflows', 'Creative & UI', 'Infra & Sec', 'Cloud & Growth'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="rtsDytRNMUXcqZtXlPZqarvwSa3aukoYtoX-if1ThTc" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StackVersus — Kinetic Benchmark Engine</title>
    <meta name="description" content="Real-time architectural benchmarks, deep telemetry specs, and pricing audits to scale modern engineering stacks." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    
   
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stackversus.pages.dev/" />
    <meta property="og:title" content="StackVersus — Kinetic Benchmark Engine" />
    <meta property="og:description" content="Real-time architectural benchmarks, deep telemetry specs, and pricing audits to scale modern engineering stacks." />
    <meta property="og:image" content="https://stackversus.pages.dev/og-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image" content="https://stackversus.pages.dev/og-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://stackversus.pages.dev/og-preview.png" />

    <style is:global>
      :root {
        --z-black: #060707;
        --z-card: rgba(14, 16, 15, 0.72);
        --z-card-hover: rgba(22, 26, 24, 0.85);
        --z-border: rgba(255, 255, 255, 0.08);
        --z-border-glow: rgba(34, 229, 118, 0.4);
        --z-lime: #22E576;
        --z-lime-glow: rgba(34, 229, 118, 0.35);
        --z-coral: #FF385C;
        --z-gold: #FFC043;
        --z-text: #F2F2F2;
        --z-muted: #8E928E;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--z-black);
        color: var(--z-text);
        min-height: 100vh;
        overflow-x: hidden;
      }

      #zajno-motion-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
      }

      .viewport-wrapper {
        position: relative;
        z-index: 1;
        width: 95%;
        max-width: 1720px;
        margin: 0 auto;
        padding: clamp(16px, 3vw, 28px) 0 60px;
      }

      /* Top HUD Bar */
      .hud-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: clamp(14px, 2vw, 24px);
        border-bottom: 1px solid var(--z-border);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
        color: var(--z-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .hud-live {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--z-lime);
        white-space: nowrap;
      }

      .hud-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--z-lime);
        box-shadow: 0 0 10px var(--z-lime);
        animation: pulse 1.8s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
      }

      /* Header & Dynamic Hero Typography */
      header {
        margin: clamp(24px, 4vw, 44px) 0 clamp(20px, 3vw, 36px);
      }

      .hero-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: clamp(0.72rem, 1.2vw, 0.8rem);
        color: var(--z-lime);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 12px;
        display: inline-block;
      }

      h1 {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2rem, 5vw, 4.4rem);
        font-weight: 800;
        line-height: 1.06;
        letter-spacing: -0.04em;
        text-transform: uppercase;
        color: #ffffff;
        word-break: break-word;
      }

      h1 span.kinetic-gradient {
        background: linear-gradient(90deg, #FFFFFF 10%, var(--z-lime) 50%, var(--z-coral) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      header p {
        font-size: clamp(0.92rem, 1.6vw, 1.05rem);
        color: var(--z-muted);
        max-width: 620px;
        margin-top: 14px;
        line-height: 1.6;
      }

      /* --- Unified Side-by-Side Toolbar --- */
      .toolbar-wrapper {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 34px;
        width: 100%;
      }

      .search-box {
        position: relative;
        flex: 0 0 clamp(260px, 28vw, 380px);
        min-width: 240px;
      }

      .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--z-muted);
        pointer-events: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.95rem;
      }

      .search-input {
        width: 100%;
        padding: 11px 16px 11px 42px;
        font-size: 0.88rem;
        font-family: 'Inter', sans-serif;
        color: #ffffff;
        background: rgba(14, 18, 16, 0.7);
        border: 1px solid var(--z-border);
        border-radius: 999px;
        backdrop-filter: blur(20px);
        outline: none;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .search-input::placeholder {
        color: var(--z-muted);
        font-size: 0.84rem;
      }

      .search-input:focus {
        border-color: var(--z-lime);
        box-shadow: 0 0 16px var(--z-lime-glow);
        background: rgba(18, 24, 21, 0.9);
      }

      .nav-container {
        display: flex;
        align-items: center;
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        mask-image: linear-gradient(to right, black 85%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, black 90%, transparent 100%);
      }
      .nav-container::-webkit-scrollbar { display: none; }

      .filter-bar {
        display: inline-flex;
        flex-wrap: nowrap;
        gap: 6px;
        padding: 5px;
        background: rgba(14, 18, 16, 0.7);
        border: 1px solid var(--z-border);
        border-radius: 999px;
        backdrop-filter: blur(20px);
        white-space: nowrap;
      }

      .filter-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 6px 16px;
        border-radius: 999px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--z-muted);
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        white-space: nowrap;
        flex-shrink: 0;
      }

      .filter-pill:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.05);
      }

      .filter-pill.active {
        background: var(--z-lime);
        color: #000000;
        font-weight: 700;
        border-color: var(--z-lime);
        box-shadow: 0 0 14px var(--z-lime-glow);
      }

      /* Grid of Cards */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 22px;
      }

      .card {
        position: relative;
        background: var(--z-card);
        border: 1px solid var(--z-border);
        border-radius: 18px;
        padding: 26px;
        text-decoration: none;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), 
                    border-color 0.32s ease, 
                    box-shadow 0.32s ease;
      }

      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--z-lime), transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .card:hover {
        background: var(--z-card-hover);
        transform: translateY(-5px);
        border-color: var(--z-border-glow);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7), 0 0 20px rgba(34, 229, 118, 0.12);
      }

      .card:hover::before { opacity: 1; }

      .card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
      }

      .card-category {
        position: relative;
        z-index: 2;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--z-lime);
        background: rgba(34, 229, 118, 0.1);
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid rgba(34, 229, 118, 0.25);
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .card-category:hover {
        background: var(--z-lime);
        color: #000000;
        box-shadow: 0 0 10px var(--z-lime-glow);
      }

      .card-idx {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.74rem;
        color: var(--z-muted);
      }

      .card h2 {
        font-family: 'Syne', sans-serif;
        font-size: 1.3rem;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin-bottom: 10px;
      }

      .card p {
        font-size: 0.9rem;
        color: var(--z-muted);
        line-height: 1.6;
        margin-bottom: 22px;
        flex-grow: 1;
      }

      .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }

      .action-pill {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--z-coral);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: gap 0.2s ease, transform 0.2s ease;
      }

      .card:hover .action-pill {
        gap: 10px;
        transform: translateX(4px);
        color: #ff5e7e;
      }

      .no-results-msg {
        display: none;
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        font-family: 'JetBrains Mono', monospace;
        color: var(--z-muted);
        font-size: 0.9rem;
        border: 1px dashed var(--z-border);
        border-radius: 16px;
        background: rgba(14, 18, 16, 0.4);
      }

      /* Site Footer */
      .site-footer {
        margin-top: 80px;
        padding-top: 32px;
        border-top: 1px solid var(--z-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.78rem;
        color: var(--z-muted);
      }

      .site-footer a {
        color: var(--z-muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      .site-footer a:hover {
        color: var(--z-lime);
      }

      /* Responsiveness */
      @media (max-width: 900px) {
        .toolbar-wrapper {
          flex-direction: column;
          align-items: stretch;
          gap: 14px;
        }
        .search-box {
          flex: 1 1 100%;
          min-width: 100%;
        }
        .nav-container {
          width: 100%;
        }
      }

      @media (max-width: 640px) {
        .hud-telemetry {
          display: none;
        }
        .viewport-wrapper {
          width: 92%;
        }
        .grid {
          grid-template-columns: 1fr;
        }
        .site-footer {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
    <!-- Motion Vector Canvas -->
    <canvas id="zajno-motion-canvas"></canvas>

    <div class="viewport-wrapper">
      <div class="hud-topbar">
        <div class="hud-live">
          <span class="hud-dot"></span>
          StackVersus // Kinetic System 2.0
        </div>
        <div class="hud-telemetry">Engine: StackVersus</div>
        <div class="hud-telemetry">State: 60 FPS Accelerated</div>
      </div>

      <header>
        <span class="hero-tag">// Unbiased Software Intelligence</span>
        <h1>
          Compare Top Tools.<br/>
          <span class="kinetic-gradient">Decide In High Motion.</span>
        </h1>
        <p>Real-time architectural benchmarks, deep telemetry specs, and pricing audits to scale modern engineering stacks.</p>
      </header>

      <!-- Horizontal Unified Toolbar -->
      <div class="toolbar-wrapper">
        <div class="search-box">
          <span class="search-icon">⌕</span>
          <input 
            type="text" 
            id="catalogSearch" 
            class="search-input" 
            placeholder="Search tools (e.g. Postgres, Docker)..." 
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="nav-container">
          <nav class="filter-bar" aria-label="Category Navigation">
            {clusters.map((cluster, i) => (
              <button class={`filter-pill ${i === 0 ? 'active' : ''}`} data-cluster={cluster}>
                {cluster}
              </button>
            ))}
          </nav>
        </div>
      </div>

      <!-- Comparison Matrix Grid -->
      <main class="grid" id="comparisons-grid">
        <div id="no-results" class="no-results-msg">
          // No matching architecture comparisons found for your search query.
        </div>

        {comparisons.map((item, index) => {
          const categorySlug = (item.data.category || 'Developer Tools')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/(^-|-$)/g, '');

          return (
            <a 
              href={`/comparisons/${item.id.replace(/\.md$/, '')}`} 
              class="card"
              data-cluster={item.cluster}
              data-title={item.data.title}
              data-category={item.data.category || ''}
              data-desc={item.data.description}
            >
              <div>
                <div class="card-meta">
                  <span 
                    class="card-category"
                    onclick={`event.stopPropagation(); window.location.href='/categories/${categorySlug}';`}
                  >
                    {item.data.category || 'Benchmark'}
                  </span>
                  <span class="card-idx">[0{index + 1}]</span>
                </div>
                <h2>{item.data.title}</h2>
                <p>{item.data.description}</p>
              </div>
              <div class="card-footer">
                <span class="action-pill">Launch Specs <span>→</span></span>
              </div>
            </a>
          );
        })}
      </main>

      <!-- E-E-A-T Footer -->
        <footer class="site-footer">
          <div>
            ©{new Date().getFullYear()} StackVersus. Independent developer tooling benchmarks.
          </div>
          <div style="display: flex; gap: 20px;">
            <a href="/about">Methodology & About</a>
            <a href="/about#disclosure">Affiliate Disclosure</a>
          </div>
        </footer>
    </div>

    <!-- Client-Side Background Ribbon Canvas -->
    <script>
      const canvas = document.getElementById('zajno-motion-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      let time = 0;
      function renderRibbon() {
        ctx.fillStyle = '#060707';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        time += 0.016;

        const normY = mouseY / Math.max(canvas.height, 1);

        ctx.strokeStyle = 'rgba(255, 255, 255, 0.025)';
        ctx.lineWidth = 1;
        const step = 60;
        for (let x = 0; x < canvas.width; x += step) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, canvas.height);
          ctx.stroke();
        }

        const ribbons = [
          { color: '#22E576', alpha: 0.35, width: 2.5, speed: 1.0, freq: 0.002, amp: 90 },
          { color: '#FF385C', alpha: 0.28, width: 2.0, speed: 1.3, freq: 0.0025, amp: 120 },
          { color: '#FFC043', alpha: 0.20, width: 1.5, speed: 0.8, freq: 0.0018, amp: 70 },
        ];

        ribbons.forEach((ribbon, i) => {
          ctx.beginPath();
          ctx.strokeStyle = ribbon.color;
          ctx.lineWidth = ribbon.width;
          ctx.globalAlpha = ribbon.alpha;

          for (let x = 0; x < canvas.width; x += 8) {
            const dynamicAmp = ribbon.amp * (0.8 + normY * 0.6);
            const y = (canvas.height * 0.5) + 
                      Math.sin(x * ribbon.freq + time * ribbon.speed + i) * dynamicAmp * Math.cos(time * 0.4 + i);

            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.stroke();
        });

        const flare = ctx.createRadialGradient(mouseX, mouseY, 10, mouseX, mouseY, 350);
        flare.addColorStop(0, 'rgba(34, 229, 118, 0.08)');
        flare.addColorStop(1, 'transparent');
        ctx.fillStyle = flare;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.globalAlpha = 1.0;
        requestAnimationFrame(renderRibbon);
      }
      renderRibbon();
    </script>

    <!-- Client-Side Search (Fuse.js) + Cluster Filter Controller -->
    <script>
      import Fuse from 'fuse.js';

      const searchInput = document.getElementById('catalogSearch') as HTMLInputElement | null;
      const noResults = document.getElementById('no-results');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');

      let currentCluster = 'All';
      let currentQuery = '';

      const searchData = cards.map((card, index) => ({
        index,
        title: card.getAttribute('data-title') || '',
        category: card.getAttribute('data-category') || '',
        desc: card.getAttribute('data-desc') || '',
      }));

      const fuse = new Fuse(searchData, {
        keys: [
          { name: 'title', weight: 0.6 },
          { name: 'category', weight: 0.25 },
          { name: 'desc', weight: 0.15 }
        ],
        threshold: 0.35,
        ignoreLocation: true
      });

      function applyFilters() {
        let matchingIndices: Set<number> | null = null;

        if (currentQuery) {
          const results = fuse.search(currentQuery);
          matchingIndices = new Set(results.map(r => r.item.index));
        }

        let visibleCount = 0;

        cards.forEach((card, idx) => {
          const cardCluster = card.getAttribute('data-cluster');
          const matchesCluster = (currentCluster === 'All' || cardCluster === currentCluster);
          const matchesSearch = matchingIndices === null || matchingIndices.has(idx);

          if (matchesCluster && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value.trim();
          applyFilters();
        });
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentCluster = btn.getAttribute('data-cluster') || 'All';
          applyFilters();
        });
      });
    </script>
  </body>
</html>