---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, schema } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="website" schema={schema}>
  <div class="container">
    <a href="/" class="back-btn">← Back to Main Arena</a>
    <slot name="heading" />
    <div class="glass-panel" id="main-content">
      <slot />
    </div>
    <slot name="after-panel" />
    <Footer />
  </div>

  <style is:global>
    .container {
      position: relative;
      z-index: 1;
      max-width: 840px;
      margin: 0 auto;
      padding: clamp(20px, 4vw, 40px) 20px 80px;
    }

    .container h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      font-weight: 800;
      margin-bottom: 24px;
      text-transform: uppercase;
      color: var(--z-text);
    }

    .container h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      color: var(--z-lime);
      margin: 32px 0 14px;
    }

    .container p {
      margin-bottom: 16px;
      color: var(--z-muted);
      font-size: 1rem;
      line-height: 1.7;
    }

    .container ul {
      padding-left: 20px;
      margin-bottom: 18px;
      color: var(--z-muted);
    }

    .container li {
      margin-bottom: 8px;
    }

    .container strong {
      color: var(--z-text);
    }

    .glass-panel {
      background: var(--z-card);
      border: 1px solid var(--z-border);
      border-radius: 16px;
      padding: clamp(24px, 4vw, 40px);
      line-height: 1.7;
      backdrop-filter: blur(20px);
    }
  </style>
</BaseLayout>
